+ AUTHORS OR COPYRIGHT HOLDERS BE LIABLE FOR ANY CLAIM, DAMAGES OR OTHER
+ LIABILITY, WHETHER IN AN ACTION OF CONTRACT, TORT OR OTHERWISE, ARISING FROM,
+ OUT OF OR IN CONNECTION WITH THE SOFTWARE OR THE USE OR OTHER DEALINGS IN THE
+ SOFTWARE. */
+
+#import "WaylandDisplay.h"
+#import "WaylandWindow.h"
+
+#import <AppKit/NSDisplay.h>
+#import <AppKit/NSPanel.h>
+#import <AppKit/NSRaise.h>
+#import <AppKit/NSScreen.h>
+#import <AppKit/NSWindow.h>
+#import <Foundation/NSException.h>
+#import <Onyx2D/O2Context.h>
+#import <Onyx2D/O2Context_builtin_FT.h>
+#import <Onyx2D/O2Surface.h>
+
+#import <errno.h>
+#import <fcntl.h>
+#import <math.h>
+#import <stdio.h>
+#import <string.h>
+#import <sys/mman.h>
+#import <unistd.h>
+
+/* ==========================================================================
+ * Shared-memory pool helper
+ *
+ * Same approach as ipa-runtime/UIKit/src/UIWindow.m:106-115
+ * (_create_shm_fd): shm_open + immediate shm_unlink so the fd alone keeps
+ * the mapping alive, no path left behind in /dev/shm. FreeBSD supports
+ * SHM_ANON (no name/unlink dance needed at all) — used when available,
+ * falling back to the named-then-unlinked form for portability with
+ * whatever glibc dev/test host this also gets built on.
+ * ========================================================================== */
+
+static int _wayland_window_create_shm_fd(size_t size) {
+    int fd = -1;
+
+#ifdef SHM_ANON
+    fd = shm_open(SHM_ANON, O_RDWR | O_CREAT | O_EXCL, 0600);
+#endif
+    if (fd < 0) {
+        static int counter = 0;
+        char path[64];
+        snprintf(path, sizeof(path), "/bsdos-waylandwindow-%d-%d",
+                 (int) getpid(), counter++);
+        fd = shm_open(path, O_RDWR | O_CREAT | O_EXCL, 0600);
+        if (fd >= 0)
+            shm_unlink(path);
+    }
+    if (fd < 0)
+        return -1;
+
+    if (ftruncate(fd, (off_t) size) < 0) {
+        close(fd);
+        return -1;
+    }
+    return fd;
+}
+
+/* ==========================================================================
+ * Per-buffer wl_buffer.release listener
+ *
+ * listener `data` is `&_buffers[i]` (a WaylandShmBuffer*, not the window),
+ * so this stays correct even if a window is deallocated mid-flight without
+ * needing a back-pointer dance.
+ * ========================================================================== */
+
+static void _wayland_buffer_release(void *data, struct wl_buffer *wlBuffer) {
+    (void) wlBuffer;
+    WaylandShmBuffer *buf = (WaylandShmBuffer *) data;
+    buf->busy = NO;
+}
+
+static const struct wl_buffer_listener _wayland_buffer_listener = {
+    .release = _wayland_buffer_release,
+};
+
+/* Private helpers, declared up front so the C listener callbacks below
+ * (which run outside the @implementation block and are wired up before
+ * the methods they call are textually defined) type-check cleanly. */
+@interface WaylandWindow ()
+- (void) _handleInitialConfigure;
+- (BOOL) _resizeBuffer: (WaylandShmBuffer *) buf
+                  width: (int32_t) width
+                 height: (int32_t) height;
+- (WaylandShmBuffer *) _acquireBackBufferForWidth: (int32_t) width
+                                            height: (int32_t) height;
+@end
+
+/* ==========================================================================
+ * xdg_surface / xdg_toplevel listeners
+ * ========================================================================== */
+
+static void _wayland_xdg_surface_configure(void *data,
+                                            struct xdg_surface *xdgSurface,
+                                            uint32_t serial) {
+    WaylandWindow *self = (WaylandWindow *) data;
+    xdg_surface_ack_configure(xdgSurface, serial);
+    [self _handleInitialConfigure];
+}
+
+static const struct xdg_surface_listener _wayland_xdg_surface_listener = {
+    .configure = _wayland_xdg_surface_configure,
+};
+
+static void _wayland_xdg_toplevel_configure(void *data,
+                                             struct xdg_toplevel *toplevel,
+                                             int32_t width, int32_t height,
+                                             struct wl_array *states) {
+    (void) data;
+    (void) toplevel;
+    (void) states;
+    /* width/height == 0 means "you choose" (the common case for a freshly
+     * mapped, non-resized toplevel) — Cocotron already knows the size it
+     * asked for via -initWithDelegate:, so there's nothing to resize to
+     * yet. A real resize-from-compositor path (user drags the SSD/CSD
+     * border) would call -[self setFrame:] here when width/height != 0;
+     * left as a TODO since interactive resize also needs xdg_toplevel's
+     * resize-edge input, which is the input agent's territory. */
+    (void) width;
+    (void) height;
+}
+
+static void _wayland_xdg_toplevel_close(void *data,
+                                         struct xdg_toplevel *toplevel) {
+    (void) toplevel;
+    WaylandWindow *self = (WaylandWindow *) data;
+    /* Route through the normal delegate close path rather than exit(0)
+     * (unlike ipa-runtime/UIKit/src/UIWindow.m:175, which is a single-window
+     * demo app) — AppKit has its own idea of whether closing this window
+     * should end the app. */
+    [[self delegate] performClose: nil];
+}
+
+static const struct xdg_toplevel_listener _wayland_xdg_toplevel_listener = {
+    .configure = _wayland_xdg_toplevel_configure,
+    .close = _wayland_xdg_toplevel_close,
+};
+
+@implementation WaylandWindow
+
+- (instancetype) initWithDelegate: (NSWindow *) delegate {
+    _delegate = delegate;
+    _level = [delegate level];
+    _styleMask = [delegate styleMask];
+
+    _waylandDisplay = (WaylandDisplay *) [NSDisplay currentDisplay];
+
+    _frame = [self transformFrame: [delegate frame]];
+    /* Guard against a zero-size buffer (X11Window does the equivalent via
+     * XCreateWindow silently accepting 0, but a wl_shm buffer with 0
+     * bytes is nonsensical) — same floor X11Window's own
+     * -transformFrame: applies (X11Window.m:717-718). */
+    if (_frame.size.width < 1.0)
+        _frame.size.width = 1.0;
+    if (_frame.size.height < 1.0)
+        _frame.size.height = 1.0;
+
+    BOOL isPanel = [delegate isKindOfClass: [NSPanel class]];
+    if (isPanel && (_styleMask & NSDocModalWindowMask))
+        _styleMask = NSBorderlessWindowMask;
+
+    struct wl_compositor *compositor = [_waylandDisplay compositor];
+    struct xdg_wm_base *wmBase = [_waylandDisplay wmBase];
+
+    _surface = wl_compositor_create_surface(compositor);
+    if (_surface == NULL) {
+        NSLog(@"WaylandWindow: wl_compositor_create_surface failed");
+        [self release];
+        return nil;
+    }
+
+    _xdgSurface = xdg_wm_base_get_xdg_surface(wmBase, _surface);
+    xdg_surface_add_listener(_xdgSurface, &_wayland_xdg_surface_listener, self);
+
+    _xdgToplevel = xdg_surface_get_toplevel(_xdgSurface);
+    xdg_toplevel_add_listener(_xdgToplevel, &_wayland_xdg_toplevel_listener, self);
+
+    const char *title = [[delegate title] UTF8String];
+    if (title != NULL)
+        xdg_toplevel_set_title(_xdgToplevel, title);
+
+    if (_styleMask & NSWindowStyleMaskResizable) {
+        xdg_toplevel_set_min_size(_xdgToplevel, 0, 0);
+        xdg_toplevel_set_max_size(_xdgToplevel, 0, 0);
+    } else {
+        xdg_toplevel_set_min_size(_xdgToplevel, (int32_t) _frame.size.width,
+                                   (int32_t) _frame.size.height);
+        xdg_toplevel_set_max_size(_xdgToplevel, (int32_t) _frame.size.width,
+                                   (int32_t) _frame.size.height);
+    }
+
+    [_waylandDisplay setWindow: self forSurface: _surface];
+
+    /* First commit with no attached buffer triggers the initial
+     * xdg_surface.configure round-trip (this is required by the xdg-shell
+     * protocol before a buffer may be attached at all). Block until it
+     * arrives, same pattern as ipa-runtime/UIKit/src/UIWindow.m:292-295. */
+    _hasPendingConfigure = YES;
+    wl_surface_commit(_surface);
+
+    struct wl_display *wlDisplay = [_waylandDisplay waylandDisplay];
+    while (_hasPendingConfigure) {
+        if (wl_display_dispatch(wlDisplay) < 0) {
+            NSLog(@"WaylandWindow: wl_display_dispatch failed while waiting "
+                  @"for initial configure: %s",
+                  strerror(errno));
+            [self release];
+            return nil;
+        }
+    }
+
+    return self;
+}
+
+- (void) _handleInitialConfigure {
+    /* purpose: mark the first xdg_surface.configure as received so
+     *          -initWithDelegate:'s blocking wait loop can proceed.
+     * input: none (invoked from the xdg_surface listener)
+     * output: none
+     * sideEffects: clears _hasPendingConfigure
+     */
+    _hasPendingConfigure = NO;
+}
+
+- (void) dealloc {
+    [self invalidate];
+    [super dealloc];
+}
+
+- (void) invalidate {
+    /* Mirrors X11Window's -invalidate contract (X11Window.m:392-422):
+     * releasable multiple times, tears down everything, notifies the
+     * delegate once. */
+    [_context release];
+    _context = nil;
+
+    if (_delegate != nil) {
+        [_delegate platformWindowDidInvalidateCGContext: self];
+        _delegate = nil;
+    }
+
+    for (int i = 0; i < WAYLAND_WINDOW_BUFFER_COUNT; i++) {
+        WaylandShmBuffer *buf = &_buffers[i];
+        if (buf->wlBuffer != NULL) {
+            wl_buffer_destroy(buf->wlBuffer);
+            buf->wlBuffer = NULL;
+        }
+        if (buf->shmData != NULL && buf->shmData != MAP_FAILED) {
+            munmap(buf->shmData, buf->poolSize);
+            buf->shmData = NULL;
+        }
+        if (buf->shmFd >= 0) {
+            close(buf->shmFd);
+            buf->shmFd = -1;
+        }
+        buf->poolSize = 0;
+        buf->width = buf->height = buf->stride = 0;
+        buf->busy = NO;
+    }
+
+    if (_xdgToplevel != NULL) {
+        xdg_toplevel_destroy(_xdgToplevel);
+        _xdgToplevel = NULL;
+    }
+    if (_xdgSurface != NULL) {
+        xdg_surface_destroy(_xdgSurface);
+        _xdgSurface = NULL;
+    }
+    if (_surface != NULL) {
+        [_waylandDisplay setWindow: nil forSurface: _surface];
+        wl_surface_destroy(_surface);
+        _surface = NULL;
+    }
+}
