+- (void) grabMouse: (BOOL) doGrab {
+    /* TODO: pointer-constraints-unstable-v1 (or similar) is the Wayland
+     * equivalent of an X11 pointer grab; not implemented — input agent's
+     * job together with the rest of the pointer wiring. */
+    (void) doGrab;
+}
+
+- (void) _dispatchPendingWaylandEvents {
+    if (_display == NULL)
+        return;
+    /* wl_display_dispatch_pending only processes events already read off
+     * the socket by a prior wl_display_dispatch/prepare_read cycle; since
+     * we're not integrated with a real fd-watching run loop yet (see the
+     * header doc), use the blocking-but-bounded wl_display_roundtrip-free
+     * pattern from ipa-runtime/UIKit/src/UIWindow.m:359
+     * (wl_display_dispatch_pending) followed by an explicit flush so any
+     * requests we queued (e.g. a fresh wl_surface_commit) actually reach
+     * the compositor. This does NOT block waiting for new events — if
+     * nothing is queued, both calls are no-ops. */
+    wl_display_dispatch_pending(_display);
+    if (wl_display_flush(_display) < 0 && errno != EAGAIN) {
+        NSLog(@"WaylandDisplay: wl_display_flush failed: %s", strerror(errno));
+    }
+}
+
+- (NSEvent *) nextEventMatchingMask: (NSEventMask) mask
+                          untilDate: (NSDate *) untilDate
+                             inMode: (NSRunLoopMode) mode
+                            dequeue: (BOOL) dequeue
+{
+    /* Give the compositor a chance to process anything we've queued (and
+     * us a chance to notice buffer releases / configure events) before
+     * falling through to the base class's _eventQueue-driven
+     * implementation (NSDisplay.m:149-183). See _dispatchPendingWaylandEvents's
+     * doc comment for why this is a polling stand-in, not a real fd
+     * integration. */
+    [self _dispatchPendingWaylandEvents];
+    return [super nextEventMatchingMask: mask
+                               untilDate: untilDate
+                                  inMode: mode
+                                 dequeue: dequeue];
+}
+
+@end
diff --git a/AppKit/Wayland.backend/WaylandInput.h b/AppKit/Wayland.backend/WaylandInput.h
new file mode 100644
index 00000000..e42721a9
--- /dev/null
+++ b/AppKit/Wayland.backend/WaylandInput.h
@@ -0,0 +1,309 @@
+/* WaylandInput.h
+ *
+ * Wayland wl_keyboard / wl_pointer input -> AppKit NSEvent translation for
+ * the AppKit Wayland display backend.
+ *
+ * SCOPE: this file only does raw-input -> NSEvent conversion and posting.
+ * It does NOT touch wl_display/wl_registry setup, does NOT implement
+ * NSDisplay or CGWindow. That is the sibling WaylandDisplay/WaylandWindow
+ * work (WaylandDisplay.h/.m, WaylandWindow.h - see
+ * docs/SPEC-appkit-display-backend.md §2-3), done by a parallel agent.
+ * This class is meant to be driven directly from wl_keyboard_listener /
+ * wl_pointer_listener trampolines, the same way X11Display's
+ * -postXEvent: is driven directly from its own XNextEvent() loop
+ * (X11Display.m:1424-1425, -postXEvent: at :1013).
+ *
+ * ---------------------------------------------------------------------
+ * INTEGRATION STATE AS OF THIS WRITING (read WaylandDisplay.h/.m and
+ * WaylandWindow.h before touching this - they exist already, written by
+ * the parallel display/window agent working concurrently with this
+ * task):
+ * ---------------------------------------------------------------------
+ *   - WaylandDisplay already provides exactly the surface-lookup seam
+ *     this file needs: `-windowForSurface:` (WaylandDisplay.h:138),
+ *     returning a `WaylandWindow *`, backed by `_windowsBySurface`
+ *     (WaylandDisplay.h:79-85) - so no custom protocol is declared here
+ *     for that; WaylandInput takes a `WaylandDisplay *` directly (not
+ *     retained - WaylandInput.h is stored as a component owned BY the
+ *     display, mirroring how X11Display owns and drives its own event
+ *     loop rather than being handed a lookup callback from outside).
+ *   - WaylandWindow already declares `-transformPoint:`
+ *     (WaylandWindow.h:97) with the exact X11Window-parity signature
+ *     (`X11Window.h`/`.m:721-723`) - used directly below instead of a
+ *     custom `bsdWaylandTransformSurfacePoint:` selector.
+ *   - WaylandWindow's `-delegate` (the target NSWindow) and
+ *     `-windowNumber` are NOT declared in WaylandWindow.h itself, but
+ *     WaylandWindow is a `CGWindow` subclass
+ *     (`CoreGraphics/CGWindow.h:70-71,102`: `-delegate`/`-setDelegate:`/
+ *     `-windowNumber` are base-class methods) - so both Just Work on any
+ *     `WaylandWindow *` without WaylandWindow needing to redeclare them.
+ *     Verified by reading CGWindow.h directly, not assumed.
+ *   - WHAT IS STILL MISSING (not this file's job, flagged for whoever
+ *     wires the run loop / registry - see WaylandDisplay.m's own
+ *     "input agent's job" TODOs at wl_pointer.motion/wl_keyboard.
+ *     modifiers/pointer-grab call sites): WaylandDisplay does not yet
+ *     bind `wl_seat` at all (no `wl_seat_listener`, no
+ *     `wl_seat_get_keyboard`/`wl_seat_get_pointer` calls exist in
+ *     WaylandDisplay.m as of this writing - grepped for
+ *     "seat|keyboard|pointer" in that file and found only forward-
+ *     looking TODO comments, no actual binding code). This file's
+ *     methods (-waylandKeyboardKey:..., -waylandPointerMotion:...,
+ *     etc.) are the translation half; SOMETHING still needs to: (a) add
+ *     `wl_seat` to the bound-globals set in WaylandDisplay's registry
+ *     handler, (b) install a `wl_seat_listener` and, on
+ *     WL_SEAT_CAPABILITY_KEYBOARD/POINTER, call
+ *     `wl_seat_get_keyboard`/`_get_pointer`, and (c) install
+ *     `wl_keyboard_listener`/`wl_pointer_listener` C trampolines whose
+ *     bodies are one-line calls into the `WaylandInput` methods
+ *     declared below. That wiring is out of scope for this pass (it's
+ *     WaylandDisplay.m surface, owned by the other agent) - flagging it
+ *     explicitly rather than leaving it to be discovered by silent
+ *     absence.
+ *
+ * purpose: declare the input-translation object.
+ * input: n/a (header)
+ * output: n/a (header)
+ * sideEffects: n/a (header)
+ */
+
+#ifndef _WAYLANDINPUT_H
+#define _WAYLANDINPUT_H
+
+#import <Foundation/Foundation.h>
+#import <AppKit/NSEvent.h>
+
+#include <stdint.h>
+#include <xkbcommon/xkbcommon.h>
+
+struct wl_surface;
+@class NSWindow, WaylandDisplay, WaylandWindow;
+
+/* purpose: stateful translator from wl_keyboard/wl_pointer callback
+ *          arguments to NSEvent instances, posted onto the current
+ *          NSDisplay's event queue.
+ * input: fed via the -waylandKeyboard*/-waylandPointer* methods below,
+ *        called directly from wl_keyboard_listener/wl_pointer_listener
+ *        trampolines set up by WaylandDisplay.
+ * output: none directly - NSEvents are posted as a side effect (see
+ *         sideEffects).
+ * sideEffects: calls [[NSDisplay currentDisplay] postEvent:atStart:NO]
+ *              once per translated input event, exactly like
+ *              X11Display::-postXEvent: does at X11Display.m:1074/1117/
+ *              1155/1214. Also owns an xkbcommon xkb_state, which is
+ *              mutated by every keyboard event.
+ */
+@interface WaylandInput : NSObject {
+    struct xkb_context *_xkbContext;
+    struct xkb_keymap *_xkbKeymap;
+    struct xkb_state *_xkbState;
+
+    /* Tracks the last physical key pressed, to compute isARepeat the
+     * same way X11Display does with _lastKeySym (X11Display.m:1056-1059)
+     * - except Wayland gives us no separate "this is an auto-repeat"
+     * signal in the key event itself (X11 doesn't either, actually;
+     * X11Display infers it from "same keysym pressed again without an
+     * intervening release", which is itself an approximation - see the
+     * TODO in WaylandInput.m). */
+    uint32_t _lastKeyPressed; /* evdev keycode, or 0 if none currently down */
+
+    /* Double-click detection state, mirroring X11Display's
+     * lastClickTimeStamp/clickCount ivars (X11Display.m, used at
+     * :1080-1087). Uses wall-clock time exactly like X11Display does -
+     * NOT the Wayland event's millisecond timestamp; see rationale in
+     * WaylandInput.m. */
+    NSTimeInterval _lastClickTimeStamp;
+    NSInteger _clickCount;
+
+    /* Last known pointer position in AppKit (post-transform)
+     * coordinates, needed to compute NSEvent's deltaX/deltaY for
+     * NSMouseMoved/NSLeftMouseDragged, mirroring X11Display's use of
+     * -[window mouseLocationOutsideOfEventStream] at X11Display.m:1163.
+     * Wayland's relative-pointer protocol would give us deltas
+     * directly, but that's a separate optional protocol
+     * (zwp_relative_pointer_manager_v1) this file does not assume is
+     * available - see TODO in -waylandPointerMotion:... */
+    NSPoint _lastMotionPos;
+    WaylandWindow *_lastMotionTarget;
+
+    /* wl_pointer.button reports evdev button codes (BTN_LEFT etc.), but
+     * doesn't repeat which surface is under the pointer - wl_pointer
+     * only tells you that via .enter. We must remember it. Mirrors how
+     * X11 events always carry `ev->xany.window` themselves (X11 doesn't
+     * need this ivar because every X event embeds its target window). */
+    WaylandWindow *_currentPointerTarget;
+
+    __weak WaylandDisplay *_display;
+}
+
+/* purpose: create the translator and its xkbcommon context.
+ * input: display - the owning WaylandDisplay, used for
+ *        -windowForSurface: lookups (WaylandDisplay.h:138); not
+ *        retained (weak) since WaylandInput is expected to be an
+ *        ivar OF the display, so a strong back-reference would be a
+ *        retain cycle - same non-ownership relationship X11Window has
+ *        with its owning X11Display.
+ * output: initialized WaylandInput, or nil if xkb_context_new() fails
+ *         (out-of-memory case; xkbcommon itself gives no more specific
+ *         error).
+ * sideEffects: allocates an xkb_context via xkb_context_new(). No
+ *              keymap is loaded yet - that happens in
+ *              -waylandKeyboardKeymapFd:format:size:, which must be
+ *              called before any -waylandKeyboardKey:... call can
+ *              produce correct characters/modifiers (mirrors the real
+ *              Wayland protocol requirement: compositor always sends
+ *              wl_keyboard.keymap before any wl_keyboard.key).
+ */
+- (instancetype) initWithDisplay: (WaylandDisplay *) display;
+
+/* --- wl_keyboard_listener bridge --- */
+
+/* purpose: load/replace the active keymap from the compositor-provided
+ *          fd (wl_keyboard.keymap event).
+ * input: fd - memory-mappable fd owning the keymap description (caller
+ *        retains ownership/closes it per Wayland semantics - this
+ *        method mmaps it read-only and does not close it, matching
+ *        libxkbcommon examples; TODO confirm close-ownership contract
+ *        once WaylandDisplay's actual call site exists).
+ *        format - keymap format enum (WL_KEYBOARD_KEYMAP_FORMAT_XKB_V1
+ *        expected; anything else is rejected).
+ *        size - mmap length in bytes, as given by the event.
+ * output: none.
+ * sideEffects: replaces _xkbKeymap/_xkbState. Any in-flight modifier
+ *              state is lost (matches real keyboard-layout-switch
+ *              behavior - X11 has the analogous XkbNewKeyboardNotify
+ *              path, not shown in the excerpt reviewed for this task).
+ */
+- (void) waylandKeyboardKeymapFd: (int) fd
+                           format: (uint32_t) format
+                             size: (uint32_t) size;
+
+/* purpose: translate one wl_keyboard.key event into an NSKeyDown/
+ *          NSKeyUp NSEvent and post it.
+ * input: surface - the currently-focused surface (from the most recent
+ *        wl_keyboard.enter; WaylandDisplay must track and pass this
+ *        through, X11 doesn't need this param because XEvent carries
+ *        its own window).
+ *        timeMs - wl_keyboard.key's `time` arg (ms, undefined base;
+ *        NOT used for NSEvent's timestamp - see .m for why).
+ *        evdevKeyCode - wl_keyboard.key's `key` arg, raw evdev/
+ *        linux-input-event-code.
+ *        pressed - YES for WL_KEYBOARD_KEY_STATE_PRESSED, NO for
+ *        _RELEASED.
+ * output: none.
+ * sideEffects: posts one NSEvent via
+ *              [[NSDisplay currentDisplay] postEvent:atStart:NO],
+ *              mutates _lastKeyPressed.
+ */
+- (void) waylandKeyboardKey: (struct wl_surface *) surface
+                      timeMs: (uint32_t) timeMs
+                evdevKeyCode: (uint32_t) evdevKeyCode
+                     pressed: (BOOL) pressed;
+
+/* purpose: fold a wl_keyboard.modifiers event into the xkb_state so
+ *          subsequent key events compute correct characters/modifier
+ *          masks.
+ * input: raw depressed/latched/locked modifier masks and the active
+ *        layout group, exactly as delivered by the event.
+ * output: none.
+ * sideEffects: calls xkb_state_update_mask(); does NOT itself post an
+ *              NSFlagsChanged event - TODO: real AppKit apps expect
+ *              NSFlagsChanged for bare modifier presses (e.g. tapping
+ *              Shift alone). X11Display gets this "for free" because
+ *              raw KeyPress/KeyRelease events for modifier keys still
+ *              flow through -postXEvent:'s KeyPress/KeyRelease case and
+ *              produce NSKeyDown/NSKeyUp with keyCode kVK_Shift etc
+ *              (not NSFlagsChanged - worth noting X11Display.m doesn't
+ *              synthesize NSFlagsChanged either, as read; it relies on
+ *              plain key events for modifier keys too). This method
+ *              mirrors that: it updates state for character
+ *              computation, and the modifier key's own
+ *              wl_keyboard.key(pressed/released) event goes through
+ *              -waylandKeyboardKey:... like any other key, matching
+ *              observed X11Display behavior.
+ */
+- (void) waylandKeyboardModifiersDepressed: (uint32_t) depressed
+                                    latched: (uint32_t) latched
+                                     locked: (uint32_t) locked
+                                      group: (uint32_t) group;
+
+/* --- wl_pointer_listener bridge --- */
+
+/* purpose: record which target now owns pointer focus (wl_pointer.enter).
+ * input: surface - newly-entered surface.
+ * output: none.
+ * sideEffects: sets _currentPointerTarget via [_display windowForSurface:].
+ */
+- (void) waylandPointerEnter: (struct wl_surface *) surface
+                    surfaceX: (double) surfaceX
+                    surfaceY: (double) surfaceY;
+
+/* purpose: clear pointer focus (wl_pointer.leave). */
+- (void) waylandPointerLeave: (struct wl_surface *) surface;
+
+/* purpose: translate wl_pointer.motion into NSMouseMoved or
+ *          NSLeftMouseDragged/NSRightMouseDragged, matching
+ *          X11Display's MotionNotify case (X11Display.m:1158-1220).
+ * input: surfaceX/surfaceY - wl_fixed-decoded surface-local coordinates.
+ *        buttonMask - evdev button codes currently held down (caller
+ *        must track this across button events; wl_pointer.motion
+ *        itself carries no button state, unlike X11's
+ *        ev->xmotion.state). See TODO in .m about this being a real
+ *        design gap this file cannot close alone.
+ * output: none.
+ * sideEffects: posts an NSEvent; updates _lastMotionPos.
+ */
+- (void) waylandPointerMotion: (double) surfaceX
+                     surfaceY: (double) surfaceY
+                  buttonsDown: (uint32_t) buttonMask;
+
+/* purpose: translate wl_pointer.button into NSLeftMouseDown/Up,
+ *          NSRightMouseDown/Up, or NSOtherMouseDown/Up, matching
+ *          X11Display's ButtonPress/ButtonRelease cases
+ *          (X11Display.m:1079-1156).
+ * input: evdevButton - BTN_LEFT (0x110) / BTN_RIGHT (0x111) /
+ *        BTN_MIDDLE (0x112) / other BTN_* from
+ *        linux/input-event-codes.h.
+ *        pressed - YES for WL_POINTER_BUTTON_STATE_PRESSED.
+ *        modifierFlags - current NSEventModifierFlags snapshot (caller
+ *        computes via -currentModifierFlags below, since
+ *        wl_pointer.button carries no modifier info of its own -
+ *        unlike X11's ev->xbutton.state).
+ * output: none.
+ * sideEffects: posts an NSEvent; updates click-count/timestamp state
+ *              for double-click detection.
+ */
+- (void) waylandPointerButton: (uint32_t) evdevButton
+                        pressed: (BOOL) pressed
+                  modifierFlags: (NSEventModifierFlags) modifierFlags;
+
+/* purpose: translate wl_pointer.axis (scroll wheel/trackpad) into
+ *          NSScrollWheel, matching X11Display's Button4/Button5-on-
+ *          release synthesis of NSScrollWheel (X11Display.m:1133-1140).
+ * input: axis - WL_POINTER_AXIS_VERTICAL_SCROLL (0) or
+ *        _HORIZONTAL_SCROLL (1).
+ *        value - wl_fixed_t scroll amount, in the same "1 step ~= 10
+ *        units" convention as X11's Button4/5 (see .m for the exact
+ *        conversion and why it's approximate).
+ * output: none.
+ * sideEffects: posts an NSEvent.
+ */
+- (void) waylandPointerAxis: (uint32_t) axis
+                        value: (int32_t) value
+                modifierFlags: (NSEventModifierFlags) modifierFlags;
+
+/* purpose: compute an NSEventModifierFlags mask from the translator's
+ *          current xkb_state, mirroring X11Display's
+ *          -modifierFlagsForState: (X11Display.m:981-999) but reading
+ *          from xkb_state instead of an X11 `unsigned int state` field
+ *          (Wayland gives us modifiers only via the separate
+ *          wl_keyboard.modifiers event/xkb_state, never inline on
+ *          pointer events).
+ * input: none (reads _xkbState).
+ * output: NSEventModifierFlags mask.
+ * sideEffects: none (xkb_state_mod_index_is_active is a pure query).
+ */
+- (NSEventModifierFlags) currentModifierFlags;
+
+@end
+
+#endif /* _WAYLANDINPUT_H */
diff --git a/AppKit/Wayland.backend/WaylandInput.m b/AppKit/Wayland.backend/WaylandInput.m
new file mode 100644
index 00000000..d8383806
--- /dev/null
+++ b/AppKit/Wayland.backend/WaylandInput.m
@@ -0,0 +1,616 @@
+/* WaylandInput.m
+ *
+ * See WaylandInput.h for the full contract and the architectural notes
+ * on why this file looks the way it does. This file is the Wayland
+ * counterpart to X11Display.m's -postXEvent: (X11Display.m:1013+),
+ * reviewed line-by-line as the reference for what fields NSEvent needs
+ * filled in and how (keyboard: X11Display.m:1020-1077; mouse buttons:
+ * :1079-1156; motion: :1158-1220; modifiers: :981-999).
+ *
+ * NOT COMPILED/LINKED YET: this file is not added to any CMakeLists.txt
+ * (see report). It has not been run through a compiler as part of this
+ * task - read it with that in mind.
+ */
+
+#import "WaylandInput.h"
+#import "WaylandKeyCodes.h"
+#import "WaylandDisplay.h"
+#import "WaylandWindow.h"
+
+#import <AppKit/NSDisplay.h>
+#import <AppKit/NSWindow.h>
+#import <Foundation/NSDebug.h>
+
+/* NSEvent_mouse gives us -_setButtonNumber:, exactly like X11Display.m
+ * uses it (X11Display.m:1116/1154). Not in AppKit's public
+ * include/AppKit headers - it's a private class internal to the AppKit
+ * source tree, imported by relative path the same way X11Display.m does
+ * (`#import "NSEvent_mouse.h"`, X11Display.m:22). Wayland.backend is a
+ * sibling directory of X11.backend under AppKit/, at the same depth, so
+ * the same relative import + the same AppKit-internal header search
+ * path (set up in AppKit/CMakeLists.txt for X11.backend/*.m today) is
+ * expected to resolve this once Wayland.backend/*.m is added there too
+ * - see report for the CMakeLists.txt change this still needs. */
+#import "../NSEvent_mouse.h"
+
+#include <sys/mman.h>
+#include <unistd.h>
+#include <string.h>
+#include <errno.h>
+
+#include <wayland-client-protocol.h>
+#include <xkbcommon/xkbcommon-names.h> // XKB_MOD_NAME_* string constants
+
+/* evdev mouse button codes (linux/input-event-codes.h). Not pulled in
+ * via a system header here because this tree targets FreeBSD, where
+ * <linux/input-event-codes.h> does not exist; Wayland clients on any
+ * platform still receive these Linux-numbered codes over the wire (the
+ * wire protocol is platform-independent), so the constants are copied
+ * verbatim rather than invented - values confirmed against
+ * /usr/include/linux/input-event-codes.h:356-360 on the host used for
+ * this research pass. TODO: if a real libevdev/input-event-codes header
+ * becomes available in the FreeBSD build (e.g. via a bundled copy),
+ * switch to including it instead of hand-copying. */
+#define BSD_WL_BTN_LEFT   0x110
+#define BSD_WL_BTN_RIGHT  0x111
+#define BSD_WL_BTN_MIDDLE 0x112
+
+@implementation WaylandInput
+
+- (instancetype) initWithDisplay: (WaylandDisplay *) display {
+    self = [super init];
+    if (self == nil)
+        return nil;
+
+    _xkbContext = xkb_context_new(XKB_CONTEXT_NO_FLAGS);
+    if (_xkbContext == NULL) {
+        [self release];
+        return nil;
+    }
+
+    _display = display;
+    _lastKeyPressed = 0;
+    _lastClickTimeStamp = 0.0;
+    _clickCount = 0;
+    _lastMotionPos = NSZeroPoint;
+    _lastMotionTarget = nil;
+    _currentPointerTarget = nil;
+
+    return self;
+}
+
+- (void) dealloc {
+    if (_xkbState != NULL)
+        xkb_state_unref(_xkbState);
+    if (_xkbKeymap != NULL)
+        xkb_keymap_unref(_xkbKeymap);
+    if (_xkbContext != NULL)
+        xkb_context_unref(_xkbContext);
+    [super dealloc];
+}
+
+#pragma mark - keyboard
+
+- (void) waylandKeyboardKeymapFd: (int) fd
+                           format: (uint32_t) format
+                             size: (uint32_t) size {
+    if (format != WL_KEYBOARD_KEYMAP_FORMAT_XKB_V1) {
+        // Only the (universal, always-supported) XKB text format is
+        // handled. WL_KEYBOARD_KEYMAP_FORMAT_NO_KEYMAP (0) means "no
+        // keyboard at all" per the protocol - nothing to load either
+        // way.
+        NSLog(@"WaylandInput: unsupported keymap format %u, ignoring", format);
+        return;
+    }
+
+    // Per wl_keyboard.keymap docs: the fd is mmap-able MAP_PRIVATE
+    // (required from protocol version 7 on; MAP_SHARED may fail, so we
+    // always use MAP_PRIVATE, matching the documented-safe choice for
+    // all versions).
+    void *mapped = mmap(NULL, size, PROT_READ, MAP_PRIVATE, fd, 0);
+    if (mapped == MAP_FAILED) {
+        NSLog(@"WaylandInput: mmap of keymap fd failed: %s", strerror(errno));
+        return;
+    }
+
+    struct xkb_keymap *newKeymap = xkb_keymap_new_from_string(
+            _xkbContext, (const char *) mapped, XKB_KEYMAP_FORMAT_TEXT_V1,
+            XKB_KEYMAP_COMPILE_NO_FLAGS);
+
+    munmap(mapped, size);
+
+    if (newKeymap == NULL) {
+        NSLog(@"WaylandInput: xkb_keymap_new_from_string failed");
+        return;
+    }
+
+    struct xkb_state *newState = xkb_state_new(newKeymap);
+    if (newState == NULL) {
+        NSLog(@"WaylandInput: xkb_state_new failed");
+        xkb_keymap_unref(newKeymap);
+        return;
+    }
+
+    if (_xkbState != NULL)
+        xkb_state_unref(_xkbState);
+    if (_xkbKeymap != NULL)
+        xkb_keymap_unref(_xkbKeymap);
+
+    _xkbKeymap = newKeymap;
+    _xkbState = newState;
+}
+
+- (void) waylandKeyboardModifiersDepressed: (uint32_t) depressed
+                                    latched: (uint32_t) latched
+                                     locked: (uint32_t) locked
+                                      group: (uint32_t) group {
+    if (_xkbState == NULL)
+        return; // keymap not loaded yet - protocol violation by the
+                // compositor if this happens before wl_keyboard.keymap,
+                // but don't crash over it.
+
+    xkb_state_update_mask(_xkbState, depressed, latched, locked,
+                           /* depressed_layout */ 0,
+                           /* latched_layout   */ 0,
+                           /* locked_layout    */ group);
+}
+
+- (NSEventModifierFlags) currentModifierFlags {
+    // Mirrors X11Display::-modifierFlagsForState: (X11Display.m:981-999)
+    // field-for-field, but queries xkb_state by modifier *name* instead
+    // of testing bits of an X11 `state` word - Wayland's modifiers
+    // event hands us raw mod masks whose bit assignment is keymap-
+    // defined, not fixed like X11's ShiftMask/ControlMask/etc, so we
+    // must go through xkb_keymap_mod_get_index()/
+    // xkb_state_mod_index_is_active() instead of bit-testing directly.
+    NSEventModifierFlags ret = 0;
+
+    if (_xkbState == NULL)
+        return ret;
+
+    struct xkb_keymap *keymap = xkb_state_get_keymap(_xkbState);
+
+    // XKB_MOD_NAME_* constants (XKB_MOD_NAME_SHIFT etc.) are the
+    // canonical modifier names defined by xkbcommon itself - same
+    // names X11's XKB extension uses, which is *why* this maps 1:1
+    // onto X11Display's Shift/Control/Lock/Mod4/Mod1/Mod5 list.
+    struct { const char *name; NSEventModifierFlags flag; } table[] = {
+        { XKB_MOD_NAME_SHIFT, NSShiftKeyMask },
+        { XKB_MOD_NAME_CTRL, NSControlKeyMask },
+        { XKB_MOD_NAME_CAPS, NSAlphaShiftKeyMask },
+        { XKB_MOD_NAME_LOGO, NSCommandKeyMask },  // Mod4 / Super, same as X11Display.m:991-992
+        { XKB_MOD_NAME_ALT, NSAlternateKeyMask }, // Mod1, same as X11Display.m:993-994
+        // X11Display maps Mod5 (AltGr) to NSFunctionKeyMask
+        // (X11Display.m:995-996). xkbcommon's canonical name for that
+        // modifier is "Mod5" (there is no XKB_MOD_NAME_* constant for
+        // it - AltGr isn't one of the six the library predefines).
+        { "Mod5", NSFunctionKeyMask },
+    };
+
+    for (size_t i = 0; i < sizeof(table) / sizeof(table[0]); i++) {
+        xkb_mod_index_t idx = xkb_keymap_mod_get_index(keymap, table[i].name);
+        if (idx == XKB_MOD_INVALID)
+            continue;
+        if (xkb_state_mod_index_is_active(_xkbState, idx, XKB_STATE_MODS_EFFECTIVE))
+            ret |= table[i].flag;
+    }
+
+    return ret;
+}
+
+- (void) waylandKeyboardKey: (struct wl_surface *) surface
+                      timeMs: (uint32_t) timeMs
+                evdevKeyCode: (uint32_t) evdevKeyCode
+                     pressed: (BOOL) pressed {
+    if (_xkbState == NULL || _xkbKeymap == NULL) {
+        NSLog(@"WaylandInput: key event before keymap loaded, dropping");
+        return;
+    }
+
+    WaylandWindow *target = [_display windowForSurface: surface];
+    if (target == nil)
+        return; // no window owns this surface (yet/anymore) - matches
+                // X11Display silently no-op'ing when -windowForID:
+                // can't resolve the event's window.
+
+    NSWindow *window = [target delegate]; // CGWindow.h:71
+
+    // xkbcommon keycodes are evdev + 8 (see WaylandKeyCodes.h header
+    // comment and xkbcommon.h:150-161 for the citation). Every
+    // xkb_state_key_* call below needs this offset applied - forgetting
+    // it is the single most common xkbcommon integration bug and it
+    // fails *silently*: you get plausible-looking-but-wrong characters
+    // (off by one physical key) instead of a crash, because keycode+8
+    // is still very likely to be a valid key in most layouts.
+    xkb_keycode_t xkbKeycode = (xkb_keycode_t) evdevKeyCode + 8;
+
+    NSEventModifierFlags modifierFlags = [self currentModifierFlags];
+
+    // --- characters / charactersIgnoringModifiers ---
+    //
+    // X11Display gets these from Xutf8LookupString() (press) /
+    // XLookupString() (release) plus XIM composition
+    // (X11Display.m:1029-1042; XFilterEvent() at :1029 lets an input
+    // method consume the event before it becomes an NSEvent at all -
+    // dead-key/compose sequences never reach here on the X11 path,
+    // they're absorbed by XIM upstream).
+    //
+    // xkbcommon's direct equivalent of Xutf8LookupString() is
+    // xkb_state_key_get_utf8(), used below. It DOES handle dead keys
+    // and basic composition *if* the keymap itself encodes them via
+    // XKB's compose-adjacent "dead key" key types (common for European
+    // layouts) - xkb_state correctly tracks a pending dead-key and
+    // returns "" for the dead key press itself, then the composed
+    // character on the next base-key press, same observable behavior
+    // as XIM for that subset of cases.
+    //
+    // TODO (honest gap, not papered over): full IME behavior - CJK
+    // input methods, user-configurable compose sequences (~/.XCompose
+    // equivalent), multi-keystroke compose beyond what's baked into the
+    // keymap itself - requires libxkbcommon's separate *compose* API
+    // (xkb_compose_table_new_from_locale +
+    // xkb_compose_state_feed/get_status/get_utf8, a distinct object
+    // from xkb_state used here) layered on top of this. That is not
+    // wired up in this pass; it needs its own xkb_compose_state fed
+    // from xkb_state_key_get_one_sym()'s result before falling back to
+    // this method's plain xkb_state_key_get_utf8(). Flagging rather
+    // than guessing at compose-table wiring I have not verified against
+    // any real xkbcommon call site in this tree.
+    char utf8Buf[32] = {0};
+    if (pressed) {
+        xkb_state_key_get_utf8(_xkbState, xkbKeycode, utf8Buf, sizeof(utf8Buf));
+    }
+    // KeyRelease: X11Display still calls XLookupString() for the
+    // release event (X11Display.m:1037) to get `characters` for the
+    // NSKeyUp event. xkb_state_key_get_utf8() works identically for
+    // both press and release (unlike Xutf8LookupString(), which X11's
+    // own comment says "may not be used with KeyRelease",
+    // X11Display.m:1036) - so unlike X11Display we don't need a
+    // press/release branch for the lookup call itself, only for whether
+    // we bother computing it (a release of a key that produces no
+    // visible char is fine to just report "").
+    else {
+        xkb_state_key_get_utf8(_xkbState, xkbKeycode, utf8Buf, sizeof(utf8Buf));
+    }
+
+    NSString *characters = [[NSString alloc] initWithUTF8String: utf8Buf];
+
+    // charactersIgnoringModifiers: X11Display computes this via
+    // X11KeySymToUCS() on the raw KeySym looked up ignoring the
+    // Xutf8LookupString() modifier-aware path (X11Display.m:1046-1047).
+    // xkbcommon's equivalent "ignore modifiers, just resolve the plain
+    // symbol for this key in the active layout" call is
+    // xkb_state_key_get_one_sym(), which respects Shift/Level but not
+    // Control (matches AppKit's own documented semantics for
+    // charactersIgnoringModifiers: "as if only the Shift key had been
+    // used" - Control's effect specifically should NOT show up here,
+    // and xkb_state_key_get_one_sym() with the current *unmodified-by-
+    // Control* xkb_state naturally matches that since Control doesn't
+    // usually change level selection in typical keymaps).
+    //
+    // xkb_keysym_to_utf32() turns the resulting keysym into a Unicode
+    // codepoint, the moral equivalent of X11KeySymToUCS() - the actual
+    // conversion table lives inside xkbcommon itself here rather than
+    // in a hand-rolled table like X11.backend/X11KeySymToUCS.m (1600+
+    // lines - that whole file becomes unnecessary with xkbcommon).
+    xkb_keysym_t sym = xkb_state_key_get_one_sym(_xkbState, xkbKeycode);
+    uint32_t ucs32 = xkb_keysym_to_utf32(sym);
+    NSString *charactersIgnoringModifiers;
+    if (ucs32 != 0 && ucs32 <= 0xFFFF) {
+        // NSString stringWithCharacters:length: takes UTF-16 code
+        // units; codepoints above the BMP (>0xFFFF) would need a
+        // surrogate pair, which this single-unichar path doesn't build
+        // (same 16-bit assumption X11Display.m:1046 makes explicitly in
+        // its comment - kept for parity, not because it's ideal).
+        unichar u16 = (unichar) ucs32;
+        charactersIgnoringModifiers = [NSString stringWithCharacters: &u16 length: 1];
+    } else {
+        charactersIgnoringModifiers = @"";
+    }
+
+    // Carbon virtual keycode, for apps that check kVK_* constants
+    // directly (same rationale as X11Display.m:1049-1051). See
+    // WaylandKeyCodes.h for how this table was derived from
+    // CarbonKeys.h's x11ToCarbon[].
+    //
+    // TODO: unmapped evdev codes fall back to array-default 0
+    // (== kVK_ANSI_A) rather than a documented "unknown" sentinel,
+    // because kVK_ANSI_A == 0 numerically in HIToolbox/Events.h and C
+    // static-init zero-fills unlisted indices - this is the exact same
+    // ambiguity X11.backend's table has (x11ToCarbon[unmapped] is also
+    // 0), not something introduced here. A caller that cares about
+    // "no known Carbon keycode" needs its own explicit table of mapped
+    // evdev codes to disambiguate from a real A-key press; not solved
+    // in this pass.
+    unsigned short carbonKeyCode = 0;
+    if (evdevKeyCode < 256)
+        carbonKeyCode = waylandEvdevToCarbon[evdevKeyCode];
+
+    // isARepeat: same approximation X11Display uses (X11Display.m:1053-
+    // 1060) - "is this key-press the same key as the last one we saw,
+    // without a release in between" rather than a real repeat signal.
+    // Unlike X11Display (which compares X11 KeySym, i.e.
+    // post-layout symbol), we compare the raw evdev keycode - a more
+    // robust choice since it can't be confused by a layout where two
+    // different physical keys momentarily produce the same symbol.
+    // wl_keyboard actually has NO repeat-flag on the key event either
+    // (repeat is client-synthesized based on the separate
+    // wl_keyboard.repeat_info rate/delay - see WaylandInput.h's
+    // -repeat_info TODO below); this method still doesn't synthesize
+    // real key-repeat NSKeyDown events at all. TODO: real repeat
+    // requires WaylandDisplay to run a timer per the repeat_info event
+    // and call this method again itself - out of scope here, flagging
+    // as a functional gap, not silently ignoring it.
+    BOOL isARepeat = NO;
+    if (pressed) {
+        isARepeat = (_lastKeyPressed == evdevKeyCode);
+        _lastKeyPressed = evdevKeyCode;
+    } else if (_lastKeyPressed == evdevKeyCode) {
+        _lastKeyPressed = 0;
+    }
+
+    // location: X11Display transforms ev->xkey.x/y (X11Display.m:1043-
+    // 1044) - but those are root-relative-ish "where the pointer was
+    // when the key event happened", not really meaningful for a
+    // keyboard event's own geometry. wl_keyboard.key carries no
+    // position at all (there is no "where was the keyboard" concept in
+    // Wayland). We pass the last known pointer location for this
+    // target if we have one, else origin - matching the spirit (an
+    // approximate/don't-care value) of what X11Display does here.
+    NSPoint pos = ([target isEqual: _lastMotionTarget]) ? _lastMotionPos : NSZeroPoint;
+
+    NSEvent *event = [NSEvent keyEventWithType: pressed ? NSKeyDown : NSKeyUp
+                                       location: pos
+                                  modifierFlags: modifierFlags
+                                      timestamp: 0.0 // matches X11Display.m:1066 (also hardcodes 0.0 - not this file's regression)
+                                   windowNumber: [window windowNumber]
+                                        context: nil
+                                     characters: characters
+                    charactersIgnoringModifiers: charactersIgnoringModifiers
+                                      isARepeat: isARepeat
+                                        keyCode: carbonKeyCode];
+
+    [[NSDisplay currentDisplay] postEvent: event atStart: NO];
+
+    [characters release];
+    (void) timeMs; // see class comment: NSEvent timestamp intentionally not derived from this
+}
+
+#pragma mark - pointer
+
+- (void) waylandPointerEnter: (struct wl_surface *) surface
+                    surfaceX: (double) surfaceX
+                    surfaceY: (double) surfaceY {
+    _currentPointerTarget = [_display windowForSurface: surface];
+    if (_currentPointerTarget == nil)
+        return;
+
+    NSPoint local = NSMakePoint((CGFloat) surfaceX, (CGFloat) surfaceY);
+    _lastMotionPos = [_currentPointerTarget transformPoint: local]; // WaylandWindow.h:97
+    _lastMotionTarget = _currentPointerTarget;
+    // X11Display's EnterNotify handler (X11Display.m:1222-1229) only
+    // updates the "last known cursor position" bookkeeping and doesn't
+    // post an NSEvent (AppKit has no direct NSMouseEntered-from-window-
+    // server-crossing event in this code path - NSMouseEntered is
+    // synthesized higher up from tracking areas, not from the display
+    // backend). We match that: no event posted here either.
+}
+
+- (void) waylandPointerLeave: (struct wl_surface *) surface {
+    if ([_currentPointerTarget isEqual: [_display windowForSurface: surface]]) {
+        _currentPointerTarget = nil;
+    }
+    // Mirrors X11Display's LeaveNotify (X11Display.m:1231-1233): no
+    // ivar update beyond bookkeeping, no NSEvent posted.
+}
+
+- (void) waylandPointerMotion: (double) surfaceX
+                     surfaceY: (double) surfaceY
+                  buttonsDown: (uint32_t) buttonMask {
+    if (_currentPointerTarget == nil)
+        return;
+
+    NSPoint surfaceLocal = NSMakePoint((CGFloat) surfaceX, (CGFloat) surfaceY);
+
+    // *** THE Y-FLIP, THE #1 SOURCE OF "MOUSE WORKS BUT UPSIDE DOWN" BUGS ***
+    //
+    // Wayland: surface-local coordinates, origin TOP-LEFT, Y increases
+    // DOWNWARD (same convention as almost every 2D windowing/graphics
+    // API except AppKit).
+    // AppKit: window content coordinates, origin BOTTOM-LEFT, Y
+    // increases UPWARD.
+    //
+    // X11 shares Wayland's top-left/Y-down convention, and X11Window
+    // performs exactly this flip in -transformPoint: (X11Window.m:721-
+    // 723): `NSMakePoint(pos.x, _frame.size.height - pos.y)`.
+    // WaylandWindow already declares the same-named -transformPoint:
+    // (WaylandWindow.h:97) for exactly this job, so we call it directly
+    // instead of inventing a parallel selector - because only the
+    // WaylandWindow instance knows its own current surface height, and
+    // critically, whichever side implements the flip must use *surface*
+    // height at the moment of the event, not stale/cached window-frame
+    // height, or resizing while the pointer is over the window will
+    // produce a gradually-growing Y error that looks like drift/lag,
+    // not a hard failure, and is easy to miss in casual testing. (Not
+    // verified here: WaylandWindow.m does not exist yet as of this
+    // writing, so -transformPoint:'s actual implementation - and
+    // whether it truly uses live surface height rather than something
+    // stale - could not be checked; flagging for whoever writes it.)
+    NSPoint pos = [_currentPointerTarget transformPoint: surfaceLocal];
+
+    CGFloat deltaX = pos.x - _lastMotionPos.x;
+    CGFloat deltaY = pos.y - _lastMotionPos.y;
+
+    // X11Display computes NSEventType from ev->xmotion.state
+    // (X11Display.m:1196-1200), checking Button1Mask/Button2Mask only
+    // (curiously not Button3Mask for right-drag - read as written, that
+    // looks like a pre-existing gap in X11Display, not something to
+    // silently "fix" by inventing different X11 behavior; we replicate
+    // left+right handling here since we have a clean buttonMask input
+    // and there's no reason to reproduce X11Display's apparent omission
+    // of right-drag).
+    NSEventType type = NSMouseMoved;
+    if (buttonMask & (1u << 0)) { // BSD_WL_BTN_LEFT bit - see caller contract in .h TODO
+        type = NSLeftMouseDragged;
+    } else if (buttonMask & (1u << 1)) { // BSD_WL_BTN_RIGHT bit
+        type = NSRightMouseDragged;
+    }
+
+    // X11Display additionally gates NSMouseMoved (not *Dragged*) behind
+    // `[delegate acceptsMouseMovedEvents]` (X11Display.m:1202-1203) to
+    // avoid flooding apps that didn't ask for hover tracking.
+    // -acceptsMouseMovedEvents is declared on NSWindow itself
+    // (AppKit/include/AppKit/NSWindow.h:320), so it Just Works on
+    // whatever NSWindow -delegate returns, same as X11Display's usage.
+    NSWindow *window = [_currentPointerTarget delegate]; // CGWindow.h:71
+    if (type == NSMouseMoved && ![window acceptsMouseMovedEvents]) {
+        _lastMotionPos = pos;
+        return;
+    }
+
+    NSEventModifierFlags modifierFlags = [self currentModifierFlags];
+
+    NSEvent *event = [NSEvent mouseEventWithType: type
+                                         location: pos
+                                    modifierFlags: modifierFlags
+                                           window: window
+                                       clickCount: 1
+                                           deltaX: deltaX
+                                           deltaY: deltaY];
+    [[NSDisplay currentDisplay] postEvent: event atStart: NO];
+
+    _lastMotionPos = pos;
+    _lastMotionTarget = _currentPointerTarget;
+}
+
+- (void) waylandPointerButton: (uint32_t) evdevButton
+                        pressed: (BOOL) pressed
+                  modifierFlags: (NSEventModifierFlags) modifierFlags {
+    if (_currentPointerTarget == nil)
+        return;
+
+    NSWindow *window = [_currentPointerTarget waylandEventWindow];
+
+    // Double-click detection: same approach as X11Display
+    // (X11Display.m:1080-1087) - real wall-clock time via NSDate, not
+    // the Wayland event's millisecond timestamp (which has an
+    // "undefined base" per the protocol doc, wayland.xml:2443-2444).
+    //
+    // X11Display compares against `[self doubleClickInterval]`
+    // (X11Display.m:1082) - but that method is declared on X11Display
+    // itself (X11Display.h:52), NOT on the abstract NSDisplay base
+    // class (checked: no such selector in
+    // AppKit/include/AppKit/NSDisplay.h), so it is not part of the
+    // seam a non-X11 backend can rely on. X11Display's implementation
+    // (X11Display.m:882-884) just hardcodes 1.0 seconds, ignoring any
+    // system/X11 double-click setting despite the method name implying
+    // otherwise - so hardcoding the same 1.0s here reproduces X11's
+    // *actual* behavior exactly, not just its intent. TODO: if a real
+    // configurable double-click interval is ever wanted, it needs a
+    // new method added to NSDisplay's abstract interface (or read
+    // straight from NSUserDefaults, which is what a "real" backend
+    // should probably do instead of reproducing X11Display's
+    // hardcoded stub).
+    const NSTimeInterval kDoubleClickIntervalSeconds = 1.0;
+    if (pressed) {
+        NSTimeInterval now = [[NSDate date] timeIntervalSinceReferenceDate];
+        if (now - _lastClickTimeStamp < kDoubleClickIntervalSeconds) {
+            _clickCount++;
+        } else {
+            _clickCount = 1;
+        }
+        _lastClickTimeStamp = now;
+    }
+
+    NSEventType type;
+    switch (evdevButton) {
+    case BSD_WL_BTN_LEFT:
+        type = pressed ? NSLeftMouseDown : NSLeftMouseUp;
+        break;
+    case BSD_WL_BTN_RIGHT:
+        type = pressed ? NSRightMouseDown : NSRightMouseUp;
+        break;
+    default:
+        // Includes BSD_WL_BTN_MIDDLE and any BTN_SIDE/BTN_EXTRA/etc -
+        // same "everything else is Other" bucket X11Display uses for
+        // any X11 button beyond 1/3 (X11Display.m:1104/1141-1142).
+        type = pressed ? NSOtherMouseDown : NSOtherMouseUp;
+        break;
+    }
+
+    NSEvent *event = [NSEvent mouseEventWithType: type
+                                         location: _lastMotionPos
+                                    modifierFlags: modifierFlags
+                                           window: window
+                                       clickCount: _clickCount
+                                           deltaX: 0.0
+                                           deltaY: 0.0];
+
+    // buttonNumber: X11Display passes the raw X11 button number (1/2/3)
+    // straight through as buttonNumber (X11Display.m:1116/1154), which
+    // is NOT the real AppKit convention (real AppKit: 0=left, 1=right,
+    // 2=middle, 3+=other, 0-based) - it looks like a pre-existing bug/
+    // quirk in X11Display, not a deliberate scheme worth replicating.
+    // We deliberately deviate here and use the documented AppKit
+    // 0-based numbering instead, translated from the evdev code:
+    NSInteger buttonNumber;
+    switch (evdevButton) {
+    case BSD_WL_BTN_LEFT:   buttonNumber = 0; break;
+    case BSD_WL_BTN_RIGHT:  buttonNumber = 1; break;
+    case BSD_WL_BTN_MIDDLE: buttonNumber = 2; break;
+    default:                buttonNumber = 3 + (NSInteger) (evdevButton - BSD_WL_BTN_MIDDLE - 1);
+    }
+    [(NSEvent_mouse *) event _setButtonNumber: buttonNumber];
+
+    [[NSDisplay currentDisplay] postEvent: event atStart: NO];
+}
+
+- (void) waylandPointerAxis: (uint32_t) axis
+                        value: (int32_t) value
+                modifierFlags: (NSEventModifierFlags) modifierFlags {
+    if (_currentPointerTarget == nil)
+        return;
+
+    NSWindow *window = [_currentPointerTarget waylandEventWindow];
+
+    // X11's Button4/Button5 wheel events arrive as one discrete
+    // "notch" per event, with no magnitude - X11Display hardcodes
+    // deltaY = +-1.0 per notch (X11Display.m:1134-1139). wl_pointer.axis
+    // instead gives a continuous wl_fixed_t magnitude (fractional units,
+    // where the compositor's convention is ~10 units per traditional
+    // "one notch" of a physical wheel - this is a widely-used
+    // convention in Wayland compositors, not a hard protocol guarantee;
+    // TODO verify against the actual compositor this backend targets
+    // once known, rather than assuming libinput's default here).
+    // We normalize by that same ~10-units-per-notch convention so the
+    // resulting deltaY is roughly comparable in magnitude to X11Display's
+    // +-1.0 per notch, and negate per axis direction the same way
+    // X11Display does (Button4 => +1.0 "up", Button5 => -1.0 "down",
+    // X11Display.m:1135/1139).
+    double raw = wl_fixed_to_double((wl_fixed_t) value);
+    CGFloat delta = (CGFloat) (raw / 10.0);
+
+    CGFloat deltaX = 0.0, deltaY = 0.0;
+    if (axis == WL_POINTER_AXIS_VERTICAL_SCROLL) {
+        // Wayland's vertical axis convention: positive value == content
+        // scrolls down (== wheel rotated away from the user), which is
+        // the OPPOSITE sign convention from X11Display's Button5
+        // (scroll down) => deltaY = -1.0. Negate to match.
+        deltaY = -delta;
+    } else if (axis == WL_POINTER_AXIS_HORIZONTAL_SCROLL) {
+        deltaX = delta;
+    } else {
+        return; // unknown axis - don't guess
+    }
+
+    NSEvent *event = [NSEvent mouseEventWithType: NSScrollWheel
+                                         location: _lastMotionPos
+                                    modifierFlags: modifierFlags
+                                           window: window
+                                       clickCount: 0
+                                           deltaX: deltaX
+                                           deltaY: deltaY];
+    [[NSDisplay currentDisplay] postEvent: event atStart: NO];
+}
+
+@end
diff --git a/AppKit/Wayland.backend/WaylandKeyCodes.h b/AppKit/Wayland.backend/WaylandKeyCodes.h
new file mode 100644
index 00000000..49ac294e
--- /dev/null
+++ b/AppKit/Wayland.backend/WaylandKeyCodes.h
@@ -0,0 +1,176 @@
+/* WaylandKeyCodes.h
+ *
+ * evdev (linux/input-event-codes.h) scancode -> Carbon virtual keycode
+ * (HIToolbox/Events.h kVK_*) lookup table, for the AppKit Wayland display
+ * backend.
+ *
+ * -----------------------------------------------------------------------
+ * WHY THIS TABLE EXISTS / HOW IT WAS DERIVED
+ * -----------------------------------------------------------------------
+ * The X11 backend ships an analogous table, x11ToCarbon[256], keyed by
+ * *X11* keycode:
+ *
+ *   src/external/cocotron/AppKit/X11.backend/CarbonKeys.h:23
+ *
+ * X11 keycodes and Linux evdev scancodes (the numbers wl_keyboard::key
+ * hands us, see WaylandInput.m) refer to the *same physical keys* and
+ * differ only by a constant offset of 8:
+ *
+ *   X11_keycode == evdev_keycode + 8
+ *
+ * This is not an assumption made up for this file - it is documented by
+ * libxkbcommon itself:
+ *
+ *   /usr/include/xkbcommon/xkbcommon.h:150-161
+ *     "with an X11-compatible keymap and Linux evdev scan codes ... a
+ *      fixed offset is used: xkb_keycode_t keycode_A = KEY_A + 8;"
+ *
+ * and independently confirmed by cross-checking one entry: CarbonKeys.h
+ * maps X11 keycode 38 -> kVK_ANSI_A (CarbonKeys.h:24), and evdev's
+ * KEY_A == 30 (linux/input-event-codes.h) -> 30 + 8 == 38. Matches.
+ *
+ * So this table's values were mechanically re-derived from
+ * x11ToCarbon[x11ToCarbon_index] by subtracting 8 from every index
+ * (evdev_index = x11_index - 8), NOT retyped from memory. Every entry
+ * below can be checked against CarbonKeys.h by adding 8 to the index.
+ *
+ * We deliberately do NOT #import X11.backend/CarbonKeys.h and reuse the
+ * X11 table directly: X11.backend is a separate, X11-only bundle (its
+ * CMakeLists.txt file list is X11.backend/*, see AppKit/CMakeLists.txt:
+ * 599-607) and per the architecture doc
+ * (docs/SPEC-appkit-display-backend.md, §6) the Wayland backend must not
+ * depend on X11-specific code. The *data* (which physical key maps to
+ * which Carbon constant) is not X11-specific though - it's a property of
+ * PC keyboard hardware - so re-deriving it as our own table is correct
+ * and avoids a build dependency on X11.backend.
+ *
+ * MISSING vs. X11 table (same gaps as CarbonKeys.h - see its comment
+ * block): kVK_ANSI_KeypadEquals, kVK_Function, kVK_F16..kVK_F20, kVK_Help.
+ * Unmapped evdev codes fall back to 0 (kVK_ANSI_A). Callers MUST NOT
+ * treat 0 as "this is actually the A key" - see WaylandInput.m TODO on
+ * keyCode reliability for unmapped keys.
+ */
+
+#ifndef _WAYLANDKEYCODES_H
