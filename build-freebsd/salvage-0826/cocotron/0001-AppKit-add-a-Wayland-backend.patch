+ copies or substantial portions of the Software.
+
+ THE SOFTWARE IS PROVIDED "AS IS", WITHOUT WARRANTY OF ANY KIND, EXPRESS OR
+ IMPLIED, INCLUDING BUT NOT LIMITED TO THE WARRANTIES OF MERCHANTABILITY,
+ FITNESS FOR A PARTICULAR PURPOSE AND NONINFRINGEMENT. IN NO EVENT SHALL THE
+ AUTHORS OR COPYRIGHT HOLDERS BE LIABLE FOR ANY CLAIM, DAMAGES OR OTHER
+ LIABILITY, WHETHER IN AN ACTION OF CONTRACT, TORT OR OTHERWISE, ARISING FROM,
+ OUT OF OR IN CONNECTION WITH THE SOFTWARE OR THE USE OR OTHER DEALINGS IN THE
+ SOFTWARE. */
+
+/*
+ * WaylandDisplay.h
+ *
+ * NSDisplay backend that talks to a Wayland compositor instead of an X11
+ * server. Modeled directly on X11.backend/X11Display.h (the only other
+ * concrete NSDisplay subclass in this tree) — see that file for the class
+ * cluster mechanics (NSDisplay's `+currentDisplay` / plugin-bundle loader,
+ * `src/external/cocotron/AppKit/NSDisplay.m:42-95`).
+ *
+ * Scope note: this backend owns *display* connection state (registry
+ * globals, outputs, per-window bookkeeping) and the plumbing needed for
+ * WaylandWindow to present pixels, PLUS the wl_seat capability path
+ * (registry bind, wl_keyboard/wl_pointer acquisition, and the C
+ * trampolines that forward raw wl_keyboard_listener/wl_pointer_listener
+ * callbacks into WaylandInput — see WaylandInput.h for the translation
+ * half, which this file drives but does not duplicate). The extension
+ * point mentioned in earlier revisions of this comment
+ * (`-_dispatchPendingWaylandEvents` / the "unimplemented wl_seat path")
+ * is now closed: wl_seat is bound like any other global below.
+ */
+
+#import <AppKit/NSDisplay.h>
+
+/* Wayland headers are isolated to backend translation units, same pattern
+ * as ipa-runtime/UIKit/src/UIWindow.m. xdg-shell-client-protocol.h is a
+ * generated file (wayland-scanner over xdg-shell.xml) — see
+ * ipa-runtime/UIKit/CMakeLists.txt:71-105 for the exact generation recipe
+ * this bundle's CMakeLists.txt (owned by a different agent) needs to
+ * replicate for Wayland.backend's build target.
+ */
+#include <wayland-client.h>
+#include <xdg-shell-client-protocol.h>
+
+@class WaylandWindow;
+@class WaylandInput;
+
+@interface WaylandDisplay : NSDisplay {
+    struct wl_display *_display;
+    struct wl_registry *_registry;
+    struct wl_compositor *_compositor;
+    struct wl_shm *_shm;
+    struct xdg_wm_base *_wmBase;
+
+    /* wl_seat and the two device objects it hands out on capability
+     * announcement. Bound at wl_seat protocol version 1 deliberately
+     * (see -_wayland_seat_capabilities in the .m) so the wl_keyboard/
+     * wl_pointer objects it produces only need the version-1 subset of
+     * wl_keyboard_listener/wl_pointer_listener — binding a newer seat
+     * version would require also handling v2+ callbacks (repeat_info,
+     * frame, axis_source, ...) that WaylandInput does not implement. */
+    struct wl_seat *_seat;
+    struct wl_keyboard *_keyboard;
+    struct wl_pointer *_pointer;
+
+    /* The translator this display drives. Owned here (strong), handed
+     * to WaylandInput as a weak back-reference at -init time — mirrors
+     * the ownership WaylandInput.h documents at WaylandInput.h:135
+     * (`__weak WaylandDisplay *_display`). */
+    WaylandInput *_input;
+
+    /* wl_keyboard carries no per-event target (unlike wl_pointer, whose
+     * .enter/.leave frame the focus change per-call) — the focused
+     * surface must be tracked across wl_keyboard.enter/.leave so it can
+     * be threaded through to -waylandKeyboardKey:timeMs:evdevKeyCode:
+     * pressed: (WaylandInput.h:197-200), which needs it in its `surface`
+     * argument. Raw wl_surface* — not retained, Wayland objects have no
+     * refcounting visible to the client. */
+    struct wl_surface *_keyboardFocusSurface;
+
+    /* wl_pointer.motion carries no button state of its own (see
+     * WaylandInput.h:128-132 and the -waylandPointerMotion:...
+     * buttonsDown: doc, WaylandInput.h:247-249) — the caller (us) must
+     * track which buttons are down from wl_pointer.button events and
+     * pass the running mask into every motion callback. Bit layout
+     * matches WaylandInput.m's own caller contract exactly: bit
+     * (evdevButton - BTN_LEFT), i.e. bit 0 = BTN_LEFT (0x110), bit 1 =
+     * BTN_RIGHT (0x111) — see WaylandInput.m:453-456's "BSD_WL_BTN_LEFT
+     * bit" / "BSD_WL_BTN_RIGHT bit" comments, which this file's
+     * trampolines must produce, not just consume. */
+    uint32_t _pointerButtonMask;
+
+    /* First (only) wl_output we bind. Multi-monitor enumeration is not
+     * implemented (see -screens in the .m for the honest TODO) — real
+     * multi-screen support needs per-output NSScreen tracking keyed by
+     * wl_output, mirroring X11Display's XRandR-driven -screens
+     * (X11Display.m:195-260).
+     */
+    struct wl_output *_output;
+    int32_t _outputWidthPx;
+    int32_t _outputHeightPx;
+    int32_t _outputScale;
+    BOOL _outputModeKnown;
+
+    /* Did the compositor's wl_shm advertise WL_SHM_FORMAT_ARGB8888? Verified
+     * (not assumed) at registry-bind time — see -_registryGlobal:... in the
+     * .m. The protocol requires ARGB8888/XRGB8888 support unconditionally,
+     * but we check anyway rather than assume a well-behaved compositor.
+     */
+    BOOL _shmFormatArgb8888Supported;
+
+    /* wl_surface* (as NSValue pointer-box) -> WaylandWindow*, so incoming
+     * wl_surface-scoped events (frame callbacks, future input events) can
+     * be routed back to the owning window. Analogous to X11Display's
+     * `_windowsByID` (X11Display.h:33), keyed by XID there vs. wl_surface*
+     * here because Wayland has no small-integer window handle.
+     */
+    NSMutableDictionary *_windowsBySurface;
+
+    /* Extension point for the input agent: last pointer location reported
+     * by wl_pointer (once that listener exists). Until then this stays at
+     * the origin and -mouseLocation says so honestly (see .m).
+     */
+    NSPoint _lastKnownMouseLocation;
+}
+
+/// purpose: expose the live wl_display* so run-loop integration (event pump)
+///          and WaylandWindow (surface/buffer creation) can drive libwayland
+///          directly instead of poking through instance variables from
+///          outside the class.
+/// input: none
+/// output: struct wl_display* (never NULL once -init has succeeded)
+/// sideEffects: none
+- (struct wl_display *) waylandDisplay;
+
+/// purpose: expose the bound wl_compositor so WaylandWindow can create
+///          wl_surface objects.
+/// input: none
+/// output: struct wl_compositor* (never NULL once -init has succeeded)
+/// sideEffects: none
+- (struct wl_compositor *) compositor;
+
+/// purpose: expose the bound wl_shm so WaylandWindow can allocate its
+///          double-buffered shm pools.
+/// input: none
+/// output: struct wl_shm* (never NULL once -init has succeeded)
+/// sideEffects: none
+- (struct wl_shm *) shm;
+
+/// purpose: expose the bound xdg_wm_base so WaylandWindow can turn its
+///          wl_surface into an xdg_surface/xdg_toplevel.
+/// input: none
+/// output: struct xdg_wm_base* (never NULL once -init has succeeded)
+/// sideEffects: none
+- (struct xdg_wm_base *) wmBase;
+
+/// purpose: register/unregister a WaylandWindow under its wl_surface so
+///          future surface-scoped compositor events (frame callbacks,
+///          and eventually input once that lands) can be dispatched back
+///          to the right NSWindow-facing object. Mirrors X11Display's
+///          `-setWindow:forID:` (X11Display.h:50, X11Display.m:935-952).
+/// input: window (nil to unregister), surface (the wl_surface* key)
+/// output: none
+/// sideEffects: mutates _windowsBySurface
+- (void) setWindow: (WaylandWindow *) window forSurface: (struct wl_surface *) surface;
+
+/// purpose: look up the WaylandWindow owning a given wl_surface.
+/// input: surface
+/// output: WaylandWindow* or nil if unknown
+/// sideEffects: none
+- (WaylandWindow *) windowForSurface: (struct wl_surface *) surface;
+
+/// purpose: pump libwayland's socket (dispatch queued events, flush pending
+///          requests) so buffer-release callbacks, xdg_surface.configure
+///          acks, and (once wired up) input events actually get processed.
+///          Cocotron's AppKit run loop has no built-in knowledge of a
+///          Wayland fd, so this must be called from somewhere reachable on
+///          every pass through the event loop; today that's
+///          -nextEventMatchingMask:untilDate:inMode:dequeue: (mirroring how
+///          X11Display folds XNextEvent-driven work into the same call,
+///          X11Display.m:958-979), which is simple but polling-based. A
+///          real integration would register the wl_display fd
+///          (wl_display_get_fd) with CFRunLoop the way X11Display does for
+///          its X11 socket under DARLING (X11Display.m:107-120) — not done
+///          here; TODO for whoever wires the run loop up properly.
+/// input: none
+/// output: none
+/// sideEffects: processes and dispatches any queued Wayland events; may
+///              invoke buffer-release / configure listeners synchronously
+- (void) _dispatchPendingWaylandEvents;
+
+@end
