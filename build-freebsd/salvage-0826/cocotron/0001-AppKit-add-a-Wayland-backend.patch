+
+#import "WaylandDisplay.h"
+#import "WaylandWindow.h"
+#import "WaylandInput.h"
+
+#import <AppKit/NSApplication.h>
+#import <AppKit/NSColor.h>
+#import <AppKit/NSDraggingManager.h>
+#import <AppKit/NSPasteboard.h>
+#import <AppKit/NSRaise.h>
+#import <AppKit/NSScreen.h>
+#import <AppKit/NSWindow.h>
+#import <Foundation/NSException.h>
+#import <Foundation/NSValue.h>
+
+#import <errno.h>
+#import <stdio.h>
+#import <stdlib.h>
+#import <string.h>
+
+/* evdev mouse button codes. Deliberately hand-copied rather than
+ * `#include <linux/input-event-codes.h>` — this tree targets FreeBSD,
+ * which has no such header, even though the Wayland wire protocol still
+ * carries Linux-numbered evdev codes on every platform. Kept in sync
+ * with WaylandInput.m's own local copy (WaylandInput.m:44-56) by value,
+ * not by sharing a header — WaylandInput.m documents these as private
+ * to that translation unit, so this file needs its own copy to build
+ * the buttonsDown bitmask it owes -waylandPointerMotion:...buttonsDown:
+ * (WaylandInput.h:255-257). */
+#define BSD_WL_BTN_LEFT   0x110
+#define BSD_WL_BTN_RIGHT  0x111
+
+@implementation WaylandDisplay
+
+/* ==========================================================================
+ * Registry / global-object callbacks
+ *
+ * Same shape as X11Display's XRandR/XKB setup in -init (X11Display.m:75-145)
+ * and the registry listener in ipa-runtime/UIKit/src/UIWindow.m:121-141 —
+ * this backend follows the latter's naming/structure since it is the
+ * existing in-tree precedent for a raw libwayland-client consumer.
+ * ========================================================================== */
+
+static void _wayland_registry_global(void *data, struct wl_registry *registry,
+                                      uint32_t name, const char *interface,
+                                      uint32_t version) {
+    WaylandDisplay *self = (WaylandDisplay *) data;
+    (void) version;
+
+    if (strcmp(interface, wl_compositor_interface.name) == 0) {
+        self->_compositor = (struct wl_compositor *) wl_registry_bind(
+                registry, name, &wl_compositor_interface, 4);
+    } else if (strcmp(interface, wl_shm_interface.name) == 0) {
+        self->_shm = (struct wl_shm *) wl_registry_bind(
+                registry, name, &wl_shm_interface, 1);
+    } else if (strcmp(interface, xdg_wm_base_interface.name) == 0) {
+        self->_wmBase = (struct xdg_wm_base *) wl_registry_bind(
+                registry, name, &xdg_wm_base_interface, 1);
+    } else if (strcmp(interface, wl_output_interface.name) == 0 &&
+               self->_output == NULL) {
+        /* Bind only the first output. Real multi-monitor support needs one
+         * NSScreen per wl_output, tracked in a dictionary the way
+         * _windowsBySurface tracks windows — not implemented, see the
+         * -screens TODO below. */
+        self->_output = (struct wl_output *) wl_registry_bind(
+                registry, name, &wl_output_interface, 2);
+    } else if (strcmp(interface, wl_seat_interface.name) == 0 &&
+               self->_seat == NULL) {
+        /* Bind at version 1 deliberately (see the ivar doc comment in
+         * WaylandDisplay.h) — the wl_keyboard/wl_pointer objects handed
+         * out by wl_seat_get_keyboard/get_pointer inherit this version,
+         * and WaylandInput's listener trampolines below only implement
+         * the version-1 callback set. */
+        self->_seat = (struct wl_seat *) wl_registry_bind(
+                registry, name, &wl_seat_interface, 1);
+    }
+}
+
+static void _wayland_registry_global_remove(void *data,
+                                             struct wl_registry *registry,
+                                             uint32_t name) {
+    (void) data;
+    (void) registry;
+    (void) name;
