+- (NSArray *) screens {
+    /* Cocotron wants at least one NSScreen to compute menu-bar placement,
+     * window cascading, etc. If we haven't received a wl_output.mode event
+     * yet (compositor hasn't sent one, or has no outputs at all — headless
+     * compositors like cage under WLR_BACKENDS=headless still normally
+     * create a virtual output, but this is not guaranteed by protocol),
+     * fall back to a documented placeholder size instead of pretending we
+     * know the real geometry. */
+    CGFloat width = _outputModeKnown ? (CGFloat) _outputWidthPx : 1024.0;
+    CGFloat height = _outputModeKnown ? (CGFloat) _outputHeightPx : 768.0;
+    if (!_outputModeKnown) {
+        NSLog(@"WaylandDisplay: no wl_output mode known yet, reporting a "
+              @"placeholder %gx%g screen", width, height);
+    }
+
+    NSRect frame = NSMakeRect(0, 0, width, height);
+    NSScreen *screen = [[[NSScreen alloc] initWithFrame: frame
+                                            visibleFrame: frame] autorelease];
+    return [NSArray arrayWithObject: screen];
+}
