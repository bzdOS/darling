diff --git a/AppKit/CMakeLists.txt b/AppKit/CMakeLists.txt
index 393a1eb3..65ad195c 100644
--- a/AppKit/CMakeLists.txt
+++ b/AppKit/CMakeLists.txt
@@ -49,6 +49,57 @@ find_package(PkgConfig REQUIRED)
 pkg_check_modules(PC_CAIRO cairo)
 pkg_check_modules(PC_FONTCONFIG fontconfig)
 
+# Wayland.backend (NSDisplay backend, sibling of X11.backend below) needs
+# wayland-client (wl_display/wl_registry/... protocol calls) and
+# xkbcommon (WaylandInput's keymap/modifier state — see
+# Wayland.backend/WaylandInput.h). REQUIRED: unlike PC_CAIRO/PC_FONTCONFIG
+# above (optional accelerants for the existing X11-only build), the
+# Wayland backend target below unconditionally lists these as
+# DEPENDENCIES, so a build tree without them fails at configure time with
+# a clear message instead of an opaque link error later.
+pkg_check_modules(PC_WAYLAND_CLIENT REQUIRED wayland-client)
+pkg_check_modules(PC_XKBCOMMON REQUIRED xkbcommon)
+
+# xdg-shell is an out-of-core Wayland protocol extension: no system header
+# ships it, so its client-side C binding (xdg-shell-client-protocol.h/.c)
+# must be generated from the upstream XML via wayland-scanner. Same
+# recipe as ipa-runtime/UIKit/CMakeLists.txt:71-105 (the existing in-tree
+# precedent for a raw libwayland-client consumer needing xdg-shell),
+# replicated here rather than shared via a common .cmake helper because
+# UIKit's CMakeLists.txt is outside this module's edit scope for this
+# pass.
+find_program(WAYLAND_SCANNER wayland-scanner)
+if (WAYLAND_SCANNER)
+	find_file(XDG_SHELL_XML xdg-shell.xml
+		PATHS
+			/usr/share/wayland-protocols/stable/xdg-shell
+			/usr/local/share/wayland-protocols/stable/xdg-shell
+	)
+
+	if (XDG_SHELL_XML)
+		set(XDG_SHELL_HEADER "${CMAKE_CURRENT_BINARY_DIR}/xdg-shell-client-protocol.h")
+		set(XDG_SHELL_CODE   "${CMAKE_CURRENT_BINARY_DIR}/xdg-shell-client-protocol.c")
+		add_custom_command(
+			OUTPUT  "${XDG_SHELL_HEADER}"
+			COMMAND "${WAYLAND_SCANNER}" client-header "${XDG_SHELL_XML}" "${XDG_SHELL_HEADER}"
+		)
+		add_custom_command(
+			OUTPUT  "${XDG_SHELL_CODE}"
+			COMMAND "${WAYLAND_SCANNER}" private-code "${XDG_SHELL_XML}" "${XDG_SHELL_CODE}"
+		)
+		set(XDG_SHELL_SOURCES "${XDG_SHELL_CODE}")
+		set(XDG_SHELL_HEADERS "${XDG_SHELL_HEADER}")
+	else()
+		message(WARNING "xdg-shell.xml not found; Wayland.backend disabled")
+		set(XDG_SHELL_SOURCES "")
+		set(XDG_SHELL_HEADERS "")
+	endif()
+else()
+	message(WARNING "wayland-scanner not found; Wayland.backend disabled")
+	set(XDG_SHELL_SOURCES "")
+	set(XDG_SHELL_HEADERS "")
+endif()
+
 include_directories(
 	${CMAKE_SOURCE_DIR}/src/external/icu/icuSources/i18n
 	${CMAKE_SOURCE_DIR}/src/external/icu/icuSources/common
@@ -68,6 +119,7 @@ include_directories(
 	${CMAKE_CURRENT_SOURCE_DIR}/NSDrawer.subproj
 
 	${CMAKE_CURRENT_SOURCE_DIR}/X11.backend
+	${CMAKE_CURRENT_SOURCE_DIR}/Wayland.backend
 
 	${X11_INCLUDE_DIR}
 	${X11_Xrandr_INCLUDE_PATH}
@@ -77,6 +129,12 @@ include_directories(
 	${OPENGL_INCLUDE_DIRS}
 	${PC_CAIRO_INCLUDE_DIRS}
 	${PC_FONTCONFIG_INCLUDE_DIRS}
+	${PC_WAYLAND_CLIENT_INCLUDE_DIRS}
+	${PC_XKBCOMMON_INCLUDE_DIRS}
+
+	# Generated xdg-shell-client-protocol.h lands here (see
+	# add_custom_command(OUTPUT "${XDG_SHELL_HEADER}" ...) above).
+	${CMAKE_CURRENT_BINARY_DIR}
 )
 
 set(AppKit_sources
@@ -622,3 +680,41 @@ add_backend(X11
 		fontconfig
 		xkbfile
 )
+
+# Wayland.backend — sibling NSDisplay backend to X11 above, added alongside
+# it (not instead of it): the X11.backend target above is untouched.
+#
+# XDG_SHELL_SOURCES/HEADERS come from the wayland-scanner generation block
+# near the top of this file; when wayland-scanner or xdg-shell.xml aren't
+# available, that block leaves them empty and this backend simply won't
+# build (guarded below) rather than failing the whole configure — same
+# "degrade, don't break the tree" behavior ipa-runtime/UIKit/CMakeLists.txt
+# uses for its own optional Wayland path.
+if (XDG_SHELL_SOURCES)
+	add_backend(Wayland
+		SOURCES
+			Wayland.backend/WaylandDisplay.m
+			Wayland.backend/WaylandWindow.m
+			Wayland.backend/WaylandInput.m
+			${XDG_SHELL_SOURCES}
+			${XDG_SHELL_HEADERS}
+		INFO_PLIST
+			Wayland.backend/Info.plist
+		DEPENDENCIES
+			objc
+			system
+			CoreFoundation
+			Foundation
+			AppKit
+			Onyx2D
+			CoreGraphics
+			OpenGL
+			QuartzCore
+			# native libraries
+			wayland-client
+			xkbcommon
+	)
+else()
+	message(WARNING "Wayland.backend not configured: xdg-shell-client-protocol.h/.c "
+		"could not be generated (see wayland-scanner/xdg-shell.xml warning above)")
+endif()
