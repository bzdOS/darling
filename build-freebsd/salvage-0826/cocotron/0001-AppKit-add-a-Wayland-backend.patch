+/* ==========================================================================
+ * Buffer (double-buffering) management
+ * ========================================================================== */
+
+- (BOOL) _resizeBuffer: (WaylandShmBuffer *) buf
+                  width: (int32_t) width
+                 height: (int32_t) height
+{
+    /*
+     * purpose: (re)allocate one WaylandShmBuffer's shm pool + wl_buffer so
+     *          it is width x height, WL_SHM_FORMAT_ARGB8888, tightly
+     *          packed (stride == width*4 to match O2Surface's own
+     *          bytesPerRow:0 packing, see -createCGContextIfNeeded above).
+     * input: buf (must not be `busy` — caller's responsibility to check),
+     *        width/height in pixels
+     * output: YES on success; NO on any allocation failure (logged, not
+     *         silently swallowed)
+     * sideEffects: destroys buf's previous wl_buffer/mapping/fd if any;
+     *              creates a new shm fd, mmap, wl_shm_pool (transient —
+     *              destroyed immediately after creating the one buffer we
+     *              need from it, same as ipa-runtime/UIKit's single-buffer
+     *              approach), and wl_buffer with a release listener
+     *              installed.
+     */
+    if (buf->wlBuffer != NULL && buf->width == width && buf->height == height)
+        return YES;
+
+    if (buf->wlBuffer != NULL) {
+        wl_buffer_destroy(buf->wlBuffer);
+        buf->wlBuffer = NULL;
+    }
+    if (buf->shmData != NULL && buf->shmData != MAP_FAILED) {
+        munmap(buf->shmData, buf->poolSize);
+        buf->shmData = NULL;
+    }
+    if (buf->shmFd >= 0) {
+        close(buf->shmFd);
+        buf->shmFd = -1;
+    }
+
+    int32_t stride = width * 4; /* ARGB8888, tightly packed */
+    size_t poolSize = (size_t) stride * (size_t) height;
+
+    int fd = _wayland_window_create_shm_fd(poolSize);
+    if (fd < 0) {
+        NSLog(@"WaylandWindow: shm allocation failed for %dx%d buffer: %s",
+              width, height, strerror(errno));
+        return NO;
+    }
+
+    void *data = mmap(NULL, poolSize, PROT_READ | PROT_WRITE, MAP_SHARED, fd, 0);
+    if (data == MAP_FAILED) {
+        NSLog(@"WaylandWindow: mmap failed for %dx%d buffer: %s", width,
+              height, strerror(errno));
+        close(fd);
+        return NO;
+    }
+
+    struct wl_shm *shm = [_waylandDisplay shm];
+    struct wl_shm_pool *pool = wl_shm_create_pool(shm, fd, (int32_t) poolSize);
+    struct wl_buffer *wlBuffer = wl_shm_pool_create_buffer(
+            pool, 0, width, height, stride, WL_SHM_FORMAT_ARGB8888);
+    /* The pool itself can be destroyed right after creating the buffer(s)
+     * we need from it — the wl_buffer keeps the underlying fd/mapping
+     * alive on the compositor side per the wl_shm protocol. */
+    wl_shm_pool_destroy(pool);
+
+    if (wlBuffer == NULL) {
+        NSLog(@"WaylandWindow: wl_shm_pool_create_buffer failed for %dx%d",
+              width, height);
+        munmap(data, poolSize);
+        close(fd);
+        return NO;
+    }
+
+    wl_buffer_add_listener(wlBuffer, &_wayland_buffer_listener, buf);
+
+    buf->wlBuffer = wlBuffer;
+    buf->shmData = data;
+    buf->poolSize = poolSize;
+    buf->shmFd = fd;
+    buf->width = width;
+    buf->height = height;
+    buf->stride = stride;
+    buf->busy = NO;
+    return YES;
+}
+
+- (WaylandShmBuffer *) _acquireBackBufferForWidth: (int32_t) width
+                                            height: (int32_t) height
+{
+    /*
+     * purpose: hand back a non-busy WaylandShmBuffer sized width x height,
+     *          resizing/allocating and blocking on the compositor's
+     *          wl_buffer.release as a last resort if every buffer we own
+     *          is currently attached and unreleased.
+     * input: width/height in pixels (the current O2Surface size)
+     * output: pointer into _buffers[] (never NULL — errors are fatal to
+     *         the flush and reported via NSLog, matching -flushBuffer's
+     *         "don't pretend it worked" requirement) or NULL on
+     *         unrecoverable allocation failure
+     * sideEffects: may block on wl_display_dispatch() waiting for a
+     *              release event; may reallocate a buffer's shm pool
+     */
+    /* Prefer an already-correctly-sized, non-busy buffer so we don't
+     * reallocate every single frame at a stable size. */
+    for (int i = 0; i < WAYLAND_WINDOW_BUFFER_COUNT; i++) {
+        WaylandShmBuffer *buf = &_buffers[i];
+        if (!buf->busy && buf->wlBuffer != NULL && buf->width == width &&
+            buf->height == height)
+            return buf;
+    }
+
+    /* Otherwise take any non-busy buffer and (re)size it. */
+    for (int i = 0; i < WAYLAND_WINDOW_BUFFER_COUNT; i++) {
+        WaylandShmBuffer *buf = &_buffers[i];
+        if (!buf->busy)
+            return [self _resizeBuffer: buf width: width height: height]
+                           ? buf
+                           : NULL;
+    }
+
+    /* Every buffer is still held by the compositor (we're presenting
+     * faster than it's releasing frames, or it's simply not pumping
+     * events). Block until one comes back rather than growing an
+     * unbounded number of buffers — bounded by WAYLAND_WINDOW_BUFFER_COUNT
+     * by design (see the header's double-buffering doc comment). This can
+     * hang if the compositor never releases a buffer (e.g. a hidden/
+     * minimized surface some compositors stop processing frame callbacks
+     * for); no timeout is implemented — TODO for production hardening.
+     */
+    struct wl_display *wlDisplay = [_waylandDisplay waylandDisplay];
+    while (YES) {
+        for (int i = 0; i < WAYLAND_WINDOW_BUFFER_COUNT; i++) {
+            WaylandShmBuffer *buf = &_buffers[i];
+            if (!buf->busy)
+                return [self _resizeBuffer: buf width: width height: height]
+                               ? buf
+                               : NULL;
+        }
+        if (wl_display_dispatch(wlDisplay) < 0) {
+            NSLog(@"WaylandWindow: wl_display_dispatch failed while waiting "
+                  @"for a free buffer: %s",
+                  strerror(errno));
+            return NULL;
+        }
+    }
+}
+
+- (void) flushBuffer {
+    /*
+     * purpose: this is the seam docs/SPEC-appkit-display-backend.md §3
+     *          calls out as "frame is ready — hand it out": copy Onyx2D's
+     *          just-rendered O2Surface into a free wl_shm buffer and
+     *          present it, replacing X11Window's GLX composite
+     *          (X11Window.m:617-644) with a direct shm attach/commit.
+     * input: none (reads _context's surface)
+     * output: none
+     * sideEffects: flushes pending Onyx2D draw ops; may block briefly
+     *              waiting for a wl_buffer.release (see
+     *              -_acquireBackBufferForWidth:height:); issues
+     *              wl_surface_attach/damage_buffer/commit + a flush
+     */
+    if (_context == nil)
+        return;
+
+    O2ContextFlush(_context);
+
+    O2Surface *surface = [_context surface];
+    int32_t width = (int32_t) O2SurfaceGetWidth(surface);
+    int32_t height = (int32_t) O2SurfaceGetHeight(surface);
+    if (width < 1 || height < 1)
+        return;
+
+    WaylandShmBuffer *buf = [self _acquireBackBufferForWidth: width
+                                                        height: height];
+    if (buf == NULL) {
+        NSLog(@"WaylandWindow: flushBuffer: no buffer available, frame dropped");
+        return;
+    }
+
+    unsigned char *srcBytes = (unsigned char *) O2SurfaceGetPixelBytes(surface);
+    size_t srcBytesPerRow = O2SurfaceGetBytesPerRow(surface);
+    size_t srcLen = srcBytesPerRow * (size_t) height;
+
+    if (srcBytesPerRow != (size_t) buf->stride || srcLen > buf->poolSize) {
+        /* Should not happen — -_resizeBuffer:width:height: sizes the wl_shm
+         * buffer to exactly match O2Surface's own tightly-packed stride
+         * (both are width*4). If it ever does, copying the wrong length
+         * would corrupt memory or leave garbage on screen, so refuse
+         * instead of guessing. */
+        NSLog(@"WaylandWindow: flushBuffer: surface stride/size mismatch "
+              @"(src %zu bytes/row, %zu total vs. buffer stride %d, pool "
+              @"%zu) — dropping frame instead of copying out of bounds",
+              srcBytesPerRow, srcLen, buf->stride, buf->poolSize);
+        return;
+    }
+
+    memcpy(buf->shmData, srcBytes, srcLen);
+    buf->busy = YES;
+
+    wl_surface_attach(_surface, buf->wlBuffer, 0, 0);
+    /* TODO: Cocotron's CGWindow base class only offers -dirtyRect: as an
+     * optional optimization hook, and X11Window (the only other backend
+     * in this tree) does not override it either — so there is no verified
+     * per-frame damage rectangle flowing down to this layer today. Damage
+     * the whole buffer every commit rather than guess a sub-rect from
+     * nothing. Cost: every commit forces the compositor to treat the full
+     * surface as changed (extra texture upload / re-composite), which
+     * matters for pure single-pixel-region updates like a blinking text
+     * caret but is not a correctness issue — just a missed optimization.
+     * Wiring real damage needs -dirtyRect: to actually be called with a
+     * meaningful rect somewhere above this class (AppKit/NSView redisplay
+     * machinery), and its coordinate space verified against this buffer's
+     * (top-left, unflipped raster) before using wl_surface_damage_buffer
+     * with anything less than the full frame. */
+    wl_surface_damage_buffer(_surface, 0, 0, width, height);
+    wl_surface_commit(_surface);
+
+    if (wl_display_flush([_waylandDisplay waylandDisplay]) < 0 &&
+        errno != EAGAIN) {
+        NSLog(@"WaylandWindow: wl_display_flush failed after commit: %s",
+              strerror(errno));
+    }
+
+    _mapped = YES;
+}
+
+/* ==========================================================================
+ * Window lifecycle (mostly limited/no-op — see per-method comments for why)
+ * ========================================================================== */
+
+- (void) showWindowWithoutActivation {
+    /* The first real presentation happens in -flushBuffer once AppKit
+     * actually draws something; there is no separate Wayland "map" request
+     * (unlike X11's XMapWindow) beyond having committed a surface, which
+     * -initWithDelegate: already did to get the initial configure. */
+}
+
+- (void) hideWindow {
+    /* xdg-shell has no "hide but keep state" request; the closest honest
+     * action a client can take is detaching its buffer, which tells the
+     * compositor to stop displaying this surface's contents. */
+    if (_surface != NULL) {
+        wl_surface_attach(_surface, NULL, 0, 0);
+        wl_surface_commit(_surface);
+    }
+}
