+- (void) warpMouse: (NSPoint) position {
+    /* Wayland gives clients no ability to warp the pointer (a deliberate
+     * protocol design choice, unlike X11's XWarpPointer). Left as a no-op
+     * rather than raising, since silently ignoring a request AppKit itself
+     * treats as best-effort is the honest behavior here — but flagged
+     * loudly so nobody mistakes this for "it worked". */
+    (void) position;
