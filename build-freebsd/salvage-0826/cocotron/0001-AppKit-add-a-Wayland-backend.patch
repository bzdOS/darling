+/*
+ * WaylandWindow.h
+ *
+ * CGWindow subclass presenting Onyx2D's software-rendered O2Surface via
+ * wl_shm, instead of X11Window's GLX-composited path
+ * (X11.backend/X11Window.h/.m). See docs/SPEC-appkit-display-backend.md §4
+ * for why GLX is not needed here: the O2Surface CPU buffer is already in
+ * the right pixel format to hand straight to a wl_buffer.
+ *
+ * Double buffering: two wl_shm-backed buffers are kept per window so a
+ * buffer the compositor is still reading (has not sent wl_buffer.release
+ * for) is never reused for the next frame — see _WaylandShmBuffer /
+ * -_acquireBackBuffer below.
+ */
+
+#import <CoreGraphics/CGWindow.h>
+#import <Onyx2D/O2Geometry.h>
+
+#include <wayland-client.h>
+#include <xdg-shell-client-protocol.h>
+
+@class WaylandDisplay, NSWindow, O2Context, O2Surface;
+
+/* One shm-backed presentation buffer. We keep NUM_WAYLAND_BUFFERS of these
+ * per window (see WaylandWindow.m) and rotate through them, tracking
+ * `busy` via the wl_buffer release listener so we never write into a
+ * buffer the compositor might still be reading from.
+ */
+typedef struct {
+    struct wl_buffer *wlBuffer;
+    void *shmData;      // mmap()'d base, size == poolSize
+    size_t poolSize;    // bytes, == stride * height
+    int shmFd;
+    int32_t width;
+    int32_t height;
+    int32_t stride;
+    BOOL busy;          // YES from attach/commit until wl_buffer.release
+} WaylandShmBuffer;
+
+#define WAYLAND_WINDOW_BUFFER_COUNT 2
+
+@interface WaylandWindow : CGWindow {
+    WaylandDisplay *_waylandDisplay; // not retained; owned by NSDisplay singleton
+    NSWindow *_delegate;             // not retained, mirrors X11Window's _delegate
+
+    struct wl_surface *_surface;
+    struct xdg_surface *_xdgSurface;
+    struct xdg_toplevel *_xdgToplevel;
+    BOOL _hasPendingConfigure; // waiting for the first xdg_surface.configure
+
+    WaylandShmBuffer _buffers[WAYLAND_WINDOW_BUFFER_COUNT];
+
+    O2Context *_context; // Onyx2D drawing context AppKit renders into
+    O2Rect _frame;        // Cocoa (bottom-left origin) coordinates
+    NSUInteger _styleMask;
+    int _level;
+    BOOL _isOpaque;
+    BOOL _hasShadow;
+    BOOL _mapped; // has an initial commit gone out
+
+    NSPoint _lastMotionPos; // extension point for the input agent
+}
+
+- (instancetype) initWithDelegate: (NSWindow *) delegate;
+
+- (O2Rect) frame;
+- (struct wl_surface *) surface;
+- (NSPoint) transformPoint: (NSPoint) pos;
+- (O2Rect) transformFrame: (O2Rect) frame;
+
+- (void) setLastKnownCursorPosition: (CGPoint) point;
+
+@end
