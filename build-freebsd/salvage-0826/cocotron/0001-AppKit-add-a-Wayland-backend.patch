+- (void) setWindow: (WaylandWindow *) window forSurface: (struct wl_surface *) surface {
+    NSValue *key = [NSValue valueWithPointer: surface];
+    if (window != nil) {
+        [_windowsBySurface setObject: window forKey: key];
+    } else {
+        [_windowsBySurface removeObjectForKey: key];
+    }
+}
+
+- (WaylandWindow *) windowForSurface: (struct wl_surface *) surface {
+    return [_windowsBySurface objectForKey: [NSValue valueWithPointer: surface]];
+}
