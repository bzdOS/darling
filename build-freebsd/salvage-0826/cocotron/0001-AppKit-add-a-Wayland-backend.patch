+/* ==========================================================================
+ * wl_seat / wl_keyboard / wl_pointer — input device acquisition and the
+ * C trampolines that forward raw callback arguments into WaylandInput
+ * (see WaylandInput.h for the translation contract; this section only
+ * does argument plumbing + the bookkeeping WaylandInput's header says
+ * the caller owns: keyboard focus surface tracking and the pointer
+ * button-down bitmask).
+ * ========================================================================== */
+
+/* purpose: wl_keyboard_listener.keymap — hand the compositor-provided
+ *          keymap fd to WaylandInput, then close it.
+ * input: standard wl_keyboard_listener callback signature.
+ * output: none.
+ * sideEffects: calls -waylandKeyboardKeymapFd:format:size: (which mmaps
+ *              the fd internally, per WaylandInput.h:160-178); closes fd
+ *              afterward — WaylandInput.h explicitly documents that it
+ *              does NOT close the fd itself ("TODO confirm close-
+ *              ownership contract", WaylandInput.h:165-166), and the
+ *              wayland-book convention is that the fd is owned by the
+ *              client once handed over in this event, so closing it
+ *              here (after the mmap WaylandInput already performed) is
+ *              the correct place to discharge that ownership.
+ */
+static void _wayland_keyboard_keymap(void *data, struct wl_keyboard *keyboard,
+                                      uint32_t format, int32_t fd,
+                                      uint32_t size) {
+    (void) keyboard;
+    WaylandDisplay *self = (WaylandDisplay *) data;
+    [self->_input waylandKeyboardKeymapFd: fd format: format size: size];
+    close(fd);
+}
+
+static void _wayland_keyboard_enter(void *data, struct wl_keyboard *keyboard,
+                                     uint32_t serial, struct wl_surface *surface,
+                                     struct wl_array *keys) {
+    (void) keyboard;
+    (void) serial;
+    (void) keys;
+    WaylandDisplay *self = (WaylandDisplay *) data;
+    /* wl_keyboard events carry no per-call surface argument (unlike
+     * wl_pointer's .enter/.leave/.motion) — WaylandInput's
+     * -waylandKeyboardKey:... needs the focused surface passed in
+     * explicitly (WaylandInput.h:182-183), so it must be remembered
+     * here across the enter/leave pair. */
+    self->_keyboardFocusSurface = surface;
+}
+
+static void _wayland_keyboard_leave(void *data, struct wl_keyboard *keyboard,
+                                     uint32_t serial, struct wl_surface *surface) {
+    (void) keyboard;
+    (void) serial;
+    WaylandDisplay *self = (WaylandDisplay *) data;
+    if (self->_keyboardFocusSurface == surface) {
+        self->_keyboardFocusSurface = NULL;
+    }
+}
+
+static void _wayland_keyboard_key(void *data, struct wl_keyboard *keyboard,
+                                   uint32_t serial, uint32_t time,
+                                   uint32_t key, uint32_t state) {
+    (void) keyboard;
+    (void) serial;
+    WaylandDisplay *self = (WaylandDisplay *) data;
+    [self->_input waylandKeyboardKey: self->_keyboardFocusSurface
+                               timeMs: time
+                         evdevKeyCode: key
+                              pressed: (state == WL_KEYBOARD_KEY_STATE_PRESSED)];
+}
+
+static void _wayland_keyboard_modifiers(void *data, struct wl_keyboard *keyboard,
+                                         uint32_t serial, uint32_t modsDepressed,
+                                         uint32_t modsLatched, uint32_t modsLocked,
+                                         uint32_t group) {
+    (void) keyboard;
+    (void) serial;
+    WaylandDisplay *self = (WaylandDisplay *) data;
+    [self->_input waylandKeyboardModifiersDepressed: modsDepressed
+                                             latched: modsLatched
+                                              locked: modsLocked
+                                               group: group];
+}
+
+static const struct wl_keyboard_listener _wayland_keyboard_listener = {
+    .keymap = _wayland_keyboard_keymap,
+    .enter = _wayland_keyboard_enter,
+    .leave = _wayland_keyboard_leave,
+    .key = _wayland_keyboard_key,
+    .modifiers = _wayland_keyboard_modifiers,
+};
+
+static void _wayland_pointer_enter(void *data, struct wl_pointer *pointer,
+                                    uint32_t serial, struct wl_surface *surface,
+                                    wl_fixed_t surfaceX, wl_fixed_t surfaceY) {
+    (void) pointer;
+    (void) serial;
+    WaylandDisplay *self = (WaylandDisplay *) data;
+    [self->_input waylandPointerEnter: surface
+                              surfaceX: wl_fixed_to_double(surfaceX)
+                              surfaceY: wl_fixed_to_double(surfaceY)];
+}
+
+static void _wayland_pointer_leave(void *data, struct wl_pointer *pointer,
+                                    uint32_t serial, struct wl_surface *surface) {
+    (void) pointer;
+    (void) serial;
+    WaylandDisplay *self = (WaylandDisplay *) data;
+    [self->_input waylandPointerLeave: surface];
+}
+
+static void _wayland_pointer_motion(void *data, struct wl_pointer *pointer,
+                                     uint32_t time, wl_fixed_t surfaceX,
+                                     wl_fixed_t surfaceY) {
+    (void) pointer;
+    (void) time;
+    WaylandDisplay *self = (WaylandDisplay *) data;
+    [self->_input waylandPointerMotion: wl_fixed_to_double(surfaceX)
+                               surfaceY: wl_fixed_to_double(surfaceY)
+                            buttonsDown: self->_pointerButtonMask];
+}
+
+static void _wayland_pointer_button(void *data, struct wl_pointer *pointer,
+                                     uint32_t serial, uint32_t time,
+                                     uint32_t button, uint32_t state) {
+    (void) pointer;
+    (void) serial;
+    (void) time;
+    WaylandDisplay *self = (WaylandDisplay *) data;
+    BOOL pressed = (state == WL_POINTER_BUTTON_STATE_PRESSED);
+
+    /* Maintain the running button-down mask -waylandPointerMotion:...
+     * needs (WaylandDisplay.h's _pointerButtonMask doc explains the bit
+     * layout: bit (evdevButton - BTN_LEFT)). Only left/right are given
+     * dedicated bits because that's all -waylandPointerMotion:...
+     * consults (WaylandInput.m:453-456) — other buttons (middle, side,
+     * ...) still get folded in at their own (evdevButton - BTN_LEFT)
+     * bit position for consistency/future-proofing, but nothing reads
+     * those bits today. */
+    if (button >= BSD_WL_BTN_LEFT && (button - BSD_WL_BTN_LEFT) < 32) {
+        /* Bounds-checked BEFORE computing the shift amount: a bare
+         * `1u << (button - BSD_WL_BTN_LEFT)` with button < BSD_WL_BTN_LEFT
+         * would underflow to a huge unsigned value and shift by >=32,
+         * which is undefined behavior in C — not just "wrong bit". */
+        uint32_t bit = 1u << (button - BSD_WL_BTN_LEFT);
+        if (pressed) {
+            self->_pointerButtonMask |= bit;
+        } else {
+            self->_pointerButtonMask &= ~bit;
+        }
+    }
+
+    NSEventModifierFlags modifierFlags = [self->_input currentModifierFlags];
+    [self->_input waylandPointerButton: button
+                                pressed: pressed
+                          modifierFlags: modifierFlags];
+}
+
+static void _wayland_pointer_axis(void *data, struct wl_pointer *pointer,
+                                   uint32_t time, uint32_t axis,
+                                   wl_fixed_t value) {
+    (void) pointer;
+    (void) time;
+    WaylandDisplay *self = (WaylandDisplay *) data;
+    NSEventModifierFlags modifierFlags = [self->_input currentModifierFlags];
+    /* wl_fixed_t IS int32_t (see <wayland-util.h>), and
+     * -waylandPointerAxis:value:modifierFlags: documents its `value`
+     * parameter as taking the raw wl_fixed_t scroll amount
+     * (WaylandInput.h:283-285) — passed straight through, no
+     * wl_fixed_to_double/int conversion needed or wanted here. */
+    [self->_input waylandPointerAxis: axis
+                                value: value
+                        modifierFlags: modifierFlags];
+}
+
+static const struct wl_pointer_listener _wayland_pointer_listener = {
+    .enter = _wayland_pointer_enter,
+    .leave = _wayland_pointer_leave,
+    .motion = _wayland_pointer_motion,
+    .button = _wayland_pointer_button,
+    .axis = _wayland_pointer_axis,
+};
+
+/// purpose: wl_seat_listener.capabilities — acquire/release wl_keyboard
+///          and wl_pointer objects as the compositor announces they
+///          became available or went away (e.g. a USB keyboard
+///          unplugged), matching the Wayland protocol's expectation
+///          that clients react to capability changes rather than
+///          assuming a fixed device set for the seat's lifetime.
+/// input: standard wl_seat_listener callback signature.
+/// output: none.
+/// sideEffects: may call wl_seat_get_keyboard/get_pointer + add the
+///              matching listener, or wl_keyboard_destroy/
+///              wl_pointer_destroy; mutates self->_keyboard/_pointer.
+static void _wayland_seat_capabilities(void *data, struct wl_seat *seat,
+                                        uint32_t capabilities) {
+    WaylandDisplay *self = (WaylandDisplay *) data;
+
+    BOOL hasKeyboard = (capabilities & WL_SEAT_CAPABILITY_KEYBOARD) != 0;
+    if (hasKeyboard && self->_keyboard == NULL) {
+        self->_keyboard = wl_seat_get_keyboard(seat);
+        wl_keyboard_add_listener(self->_keyboard, &_wayland_keyboard_listener, self);
+    } else if (!hasKeyboard && self->_keyboard != NULL) {
+        wl_keyboard_destroy(self->_keyboard);
+        self->_keyboard = NULL;
+        self->_keyboardFocusSurface = NULL;
+    }
+
+    BOOL hasPointer = (capabilities & WL_SEAT_CAPABILITY_POINTER) != 0;
+    if (hasPointer && self->_pointer == NULL) {
+        self->_pointer = wl_seat_get_pointer(seat);
+        wl_pointer_add_listener(self->_pointer, &_wayland_pointer_listener, self);
+    } else if (!hasPointer && self->_pointer != NULL) {
+        wl_pointer_destroy(self->_pointer);
+        self->_pointer = NULL;
+        self->_pointerButtonMask = 0;
+    }
+}
+
+static void _wayland_seat_name(void *data, struct wl_seat *seat,
+                                const char *name) {
+    (void) data;
+    (void) seat;
+    (void) name;
+    /* Multi-seat disambiguation (picking a named seat over "default")
+     * is not implemented — this backend uses whichever single wl_seat
+     * the compositor advertises first, same simplification as the
+     * single-wl_output handling above. */
+}
+
+static const struct wl_seat_listener _wayland_seat_listener = {
+    .capabilities = _wayland_seat_capabilities,
+    .name = _wayland_seat_name,
+};
+
+/* ==========================================================================
+ * NSDisplay overrides
+ * ========================================================================== */
+
+- init {
+    /* Same "concrete subclass init" contract as X11Display -init
+     * (X11Display.m:75-145): call [super init] first (NSDisplay's -init
+     * special-cases subclasses to just allocate _eventQueue and return,
+     * NSDisplay.m:46-51), then do backend-specific connection setup,
+     * returning nil on any failure so NSDisplay's plugin loader
+     * (NSDisplay.m:76-85) moves on to the next-priority backend. */
+    if (self = [super init]) {
+        _display = wl_display_connect(NULL);
+        if (_display == NULL) {
+            NSLog(@"WaylandDisplay: wl_display_connect failed (WAYLAND_DISPLAY=%s)",
+                  getenv("WAYLAND_DISPLAY") ? getenv("WAYLAND_DISPLAY") : "(unset)");
+            [self release];
+            return nil;
+        }
+
+        _outputScale = 1;
+        _windowsBySurface = [NSMutableDictionary new];
+        _lastKnownMouseLocation = NSZeroPoint;
+
+        _registry = wl_display_get_registry(_display);
+        wl_registry_add_listener(_registry, &_wayland_registry_listener, self);
+
+        /* First roundtrip: receive the registry.global advertisements and
+         * bind compositor/shm/xdg_wm_base/output. */
+        wl_display_roundtrip(_display);
+
+        if (_compositor == NULL || _shm == NULL || _wmBase == NULL) {
+            NSLog(@"WaylandDisplay: compositor did not advertise a required "
+                  @"global (compositor=%p shm=%p xdg_wm_base=%p) — cannot use "
+                  @"this backend",
+                  (void *) _compositor, (void *) _shm, (void *) _wmBase);
+            [self release];
+            return nil;
+        }
+
+        /* Wire up listeners on the objects we just bound, then do a second
+         * roundtrip so their initial events (wl_shm.format, wl_output's
+         * geometry/mode/done/scale, ping is compositor-driven not needed
+         * here) are delivered before we report ourselves ready. */
+        wl_shm_add_listener(_shm, &_wayland_shm_listener, self);
+        xdg_wm_base_add_listener(_wmBase, &_wayland_wm_base_listener, self);
+        if (_output != NULL) {
+            wl_output_add_listener(_output, &_wayland_output_listener, self);
+        }
+        if (_seat != NULL) {
+            /* wl_seat.capabilities (and .name) arrive from this listener;
+             * the roundtrip below delivers the initial capabilities
+             * event so -_wayland_seat_capabilities can acquire
+             * wl_keyboard/wl_pointer before -init returns, same timing
+             * as the shm/output listeners above. A compositor with no
+             * wl_seat at all (unusual, but not protocol-mandatory) is
+             * tolerated: keyboard/pointer just never appear, and
+             * WaylandInput's translation methods are simply never
+             * invoked — not treated as a fatal -init error, since a
+             * display with no input devices is still a valid display. */
+            wl_seat_add_listener(_seat, &_wayland_seat_listener, self);
+        } else {
+            NSLog(@"WaylandDisplay: compositor did not advertise wl_seat — "
+                  @"no keyboard/pointer input will be available");
+        }
+        wl_display_roundtrip(_display);
+
+        /* WaylandInput owns the xkbcommon context; construct it once
+         * wl_seat setup (if any) is in flight so its trampolines above
+         * have somewhere to forward events the moment wl_keyboard/
+         * wl_pointer show up in the roundtrip just issued. Not fatal if
+         * this fails (mirrors the "not fatal" wl_seat-absent case just
+         * above) — xkb_context_new() only fails on allocation failure,
+         * and losing keyboard translation is not a reason to refuse the
+         * whole display connection. */
+        _input = [[WaylandInput alloc] initWithDisplay: self];
+        if (_input == nil) {
+            NSLog(@"WaylandDisplay: WaylandInput init failed (xkb_context_new "
+                  @"out of memory?) — keyboard/pointer events will be dropped");
+        }
+
+        if (!_shmFormatArgb8888Supported) {
+            /* WL_SHM_FORMAT_ARGB8888 is mandatory per the wl_shm protocol
+             * (every compositor must support it), so this should be
+             * unreachable — but we verify rather than assume, per project
+             * rule against silent success paths. */
+            NSLog(@"WaylandDisplay: compositor's wl_shm did not advertise "
+                  @"WL_SHM_FORMAT_ARGB8888 — refusing to guess a pixel format");
+            [self release];
+            return nil;
+        }
+
+        return self;
+    }
+    return self;
+}
+
+- (void) dealloc {
+    [_windowsBySurface release];
+    [_input release];
+
+    if (_keyboard != NULL)
+        wl_keyboard_destroy(_keyboard);
+    if (_pointer != NULL)
+        wl_pointer_destroy(_pointer);
+    if (_seat != NULL)
+        wl_seat_destroy(_seat);
+    if (_output != NULL)
+        wl_output_destroy(_output);
+    if (_wmBase != NULL)
+        xdg_wm_base_destroy(_wmBase);
+    if (_shm != NULL)
+        wl_shm_destroy(_shm);
+    if (_compositor != NULL)
+        wl_compositor_destroy(_compositor);
+    if (_registry != NULL)
+        wl_registry_destroy(_registry);
+    if (_display != NULL)
+        wl_display_disconnect(_display);
+
+    [super dealloc];
+}
+
+- (struct wl_display *) waylandDisplay {
+    return _display;
+}
+
+- (struct wl_compositor *) compositor {
+    return _compositor;
+}
+
+- (struct wl_shm *) shm {
+    return _shm;
+}
+
+- (struct xdg_wm_base *) wmBase {
+    return _wmBase;
+}
