+
+- (NSPoint) transformPoint: (NSPoint) pos {
+    /* Same top-left-origin (Wayland) <-> bottom-left-origin (Cocoa) flip
+     * X11Window performs (X11Window.m:713-719), against our tracked
+     * primary output height instead of X11's DisplayHeight(). Falls back
+     * to the same 768px placeholder WaylandDisplay.m's -screens uses if no
+     * real output mode has been reported yet, so the two stay consistent
+     * with each other even in that degraded state. */
+    NSArray *screens = [[NSDisplay currentDisplay] screens];
+    CGFloat screenHeight = 768.0;
+    if ([screens count] > 0)
+        screenHeight = [(NSScreen *) [screens objectAtIndex: 0] frame].size.height;
+    return NSMakePoint(pos.x, screenHeight - pos.y);
+}
+
+- (O2Rect) transformFrame: (O2Rect) frame {
+    NSArray *screens = [[NSDisplay currentDisplay] screens];
+    CGFloat screenHeight = 768.0;
+    if ([screens count] > 0)
+        screenHeight = [(NSScreen *) [screens objectAtIndex: 0] frame].size.height;
+    return NSMakeRect(frame.origin.x,
+                      screenHeight - frame.origin.y - frame.size.height,
+                      fmax(frame.size.width, 1.0),
+                      fmax(frame.size.height, 1.0));
+}
