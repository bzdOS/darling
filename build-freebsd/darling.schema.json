{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "darling.toml",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "env", "keepone", "stubs"],
  "properties": {
    "schema_version": {"type": "integer", "enum": [1]},
    "env": {
      "type": "object",
      "additionalProperties": false,
      "required": ["DARLING_SRC_DIR", "DARLING_BUILD_DIR", "DARLING_OVERLAY", "KEEPONE_ROOT", "DARLING_DISK_MAX"],
      "properties": {
        "DARLING_SRC_DIR": {"$ref": "#/$defs/abspath"},
        "DARLING_BUILD_DIR": {"$ref": "#/$defs/abspath"},
        "DARLING_OVERLAY": {"$ref": "#/$defs/abspath"},
        "DARLING_MLDR_PATH": {"$ref": "#/$defs/abspath"},
        "KEEPONE_ROOT": {"$ref": "#/$defs/abspath"},
        "DARLING_DISK_MAX": {"type": "integer", "minimum": 50, "maximum": 99}, "PROBE_TIMEOUT": {"type": "integer", "minimum": 60, "maximum": 1800}, "DSERVER_SOCKET_RCVBUF": {"type": "integer", "minimum": 16384, "maximum": 2097152}, "PREFLIGHT_DISK_DEV": {"type": "string", "pattern": "^[a-z]+[0-9]+$"}, "PREFLIGHT_DISK_MSW_START": {"type": "integer", "minimum": 1, "maximum": 10000}, "PREFLIGHT_DISK_QLEN_MAX": {"type": "integer", "minimum": 0, "maximum": 256}, "PREFLIGHT_DISK_MSW_STOP": {"type": "integer", "minimum": 1, "maximum": 100000}, "DSERVER_DIAG_RING": {"type": "integer", "minimum": 0, "maximum": 4000000}
      }
    },
    "keepone": {
      "type": "object",
      "additionalProperties": false,
      "required": ["files", "backups"],
      "properties": {
        "files": {"$ref": "#/$defs/globs"},
        "backups": {"$ref": "#/$defs/globs"}
      }
    },
    "stubs": {
      "type": "object",
      "additionalProperties": false,
      "required": ["k_prefixes", "exact", "patterns"],
      "properties": {
        "k_prefixes": {"type": "array", "items": {"type": "string", "pattern": "^[A-Z][A-Za-z]{1,3}$"}},
        "exact": {"type": "array", "items": {"type": "string", "pattern": "^_[A-Za-z0-9_]+$"}},
        "patterns": {"type": "array", "items": {"type": "string", "minLength": 1}}
      }
    },
    "run": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "series": {
          "type": "object",
          "propertyNames": {"pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"},
          "additionalProperties": {"$ref": "#/$defs/series"}
        }
      }
    }
  },
  "$defs": {
    "abspath": {"type": "string", "pattern": "^/[^'\"\\s]*$"},
    "glob": {"type": "string", "minLength": 1, "pattern": "^[^'\"\\s/]+$"},
    "globs": {"type": "array", "items": {"$ref": "#/$defs/glob"}},
    "series": {
      "type": "object",
      "additionalProperties": false,
      "required": ["prefix", "runs", "timeout"],
      "properties": {
        "prefix": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"},
        "runs": {"type": "integer", "minimum": 1, "maximum": 100},
        "timeout": {"type": "integer", "minimum": 10, "maximum": 3600},
        "chrome_extra_args": {"type": "string", "pattern": "^[^'\\n]*$"},
        "trap_log": {"type": "integer", "enum": [0, 1]},
        "ktrace": {"type": "string", "pattern": "^(/[^'\"\\s]*)?$"},
        "ktrace_points": {"type": "string", "pattern": "^[a-zA-Z+]*$"}
      }
    }
  }
}
