diff -ru a/src/startup/mldr/freebsd_syscall_trap.c b/src/startup/mldr/freebsd_syscall_trap.c
--- a/src/startup/mldr/freebsd_syscall_trap.c	2026-11-22 02:51:35.103246000 +0000
+++ b/src/startup/mldr/freebsd_syscall_trap.c	2026-11-22 02:53:03.412391000 +0000
@@ -4335,6 +4335,110 @@
  *              actually executed by the CPU); re-raises as the default
  *              action for any #UD that isn't one of our own patches.
  */
+/* Step 56 residual-path diagnostics (DARLING_SIG65_COUNT set): per duplicate, si_addr - rip, whether sigill_handler was nested on this
+ * thread (depth by tid & 63, so no TLS), whether a signal 65+ handler was in progress in the process (mldr_sig65_inflight, kept by the
+ * trampoline), and whether a real-time signal was pending on the thread. Fixed array, claimed by one atomic add; no locks, stdio or malloc. */
+#define MLDR_DUPREC_MAX 256
+struct mldr_duprec { long delta; unsigned char nested, inflight, pending, valid; };
+static struct mldr_duprec mldr_duprecs[MLDR_DUPREC_MAX];
+static volatile unsigned long mldr_duprec_n;
+static volatile int mldr_sigill_depth[64];
+volatile int mldr_sig65_inflight;
+static int mldr_dupdiag_on = -1;
+
+static void
+mldr_dupdiag_fmt(char **pp, long v)
+{
+    char tmp[24];
+    char *e = tmp + sizeof(tmp);
+    char *lo;
+    char *p = *pp;
+    if (v < 0) {
+        *p++ = '-';
+        v = -v;
+    }
+    lo = mldr_fmt_dec(e, v);
+    while (lo < e)
+        *p++ = *lo++;
+    *pp = p;
+}
+
+static void
+mldr_dupdiag_report(void)
+{
+    static const char tag[] = "[sigill-dup-hist] delta nested sig65_inflight rt_pending count\n";
+    static const char ovf[] = "[sigill-dup-hist] overflow (records beyond 256 dropped)\n";
+    unsigned long n = __atomic_load_n(&mldr_duprec_n, __ATOMIC_RELAXED);
+    unsigned char done[MLDR_DUPREC_MAX];
+    if (n == 0)
+        return;
+    if (n > MLDR_DUPREC_MAX)
+        n = MLDR_DUPREC_MAX;
+    memset(done, 0, sizeof(done));
+    (void)!write(2, tag, sizeof(tag) - 1);
+    for (unsigned long i = 0; i < n; i++) {
+        long cnt = 0;
+        char buf[96];
+        char *p = buf;
+        if (done[i] || !__atomic_load_n(&mldr_duprecs[i].valid, __ATOMIC_ACQUIRE))
+            continue;
+        for (unsigned long j = i; j < n; j++) {
+            if (!done[j] && mldr_duprecs[j].valid && mldr_duprecs[j].delta == mldr_duprecs[i].delta &&
+                mldr_duprecs[j].nested == mldr_duprecs[i].nested && mldr_duprecs[j].inflight == mldr_duprecs[i].inflight &&
+                mldr_duprecs[j].pending == mldr_duprecs[i].pending) {
+                done[j] = 1;
+                cnt++;
+            }
+        }
+        memcpy(p, "[sigill-dup-hist] ", 18);
+        p += 18;
+        mldr_dupdiag_fmt(&p, mldr_duprecs[i].delta);
+        *p++ = ' ';
+        mldr_dupdiag_fmt(&p, mldr_duprecs[i].nested);
+        *p++ = ' ';
+        mldr_dupdiag_fmt(&p, mldr_duprecs[i].inflight);
+        *p++ = ' ';
+        mldr_dupdiag_fmt(&p, mldr_duprecs[i].pending);
+        *p++ = ' ';
+        mldr_dupdiag_fmt(&p, cnt);
+        *p++ = '\n';
+        (void)!write(2, buf, (size_t)(p - buf));
+    }
+    if (__atomic_load_n(&mldr_duprec_n, __ATOMIC_RELAXED) > MLDR_DUPREC_MAX)
+        (void)!write(2, ovf, sizeof(ovf) - 1);
+}
+
+static volatile int mldr_dupdiag_reported;
+static void
+mldr_dupdiag_report_once(void)
+{
+    if (__atomic_exchange_n(&mldr_dupdiag_reported, 1, __ATOMIC_RELAXED))
+        return;
+    mldr_dupdiag_report();
+}
+__attribute__((constructor)) static void
+mldr_dupdiag_register_atexit(void)
+{
+    atexit(mldr_dupdiag_report_once);
+}
+
+static void
+mldr_dupdiag_record(long delta, int nested)
+{
+    unsigned long idx = __atomic_fetch_add(&mldr_duprec_n, 1, __ATOMIC_RELAXED);
+    unsigned long ps[2] = {0, 0};   /* sigset_t is 4 words; the real-time signals are in words 2 and 3 */
+    unsigned long set[4] = {0, 0, 0, 0};
+    if (idx >= MLDR_DUPREC_MAX)
+        return;
+    freebsd_raw_syscall(SYS_sigpending, (long)set, 0, 0, 0, 0, 0);
+    ps[0] = set[2]; ps[1] = set[3];
+    mldr_duprecs[idx].delta = delta;
+    mldr_duprecs[idx].nested = (unsigned char)nested;
+    mldr_duprecs[idx].inflight = __atomic_load_n(&mldr_sig65_inflight, __ATOMIC_RELAXED) > 0;
+    mldr_duprecs[idx].pending = (ps[0] | ps[1]) != 0;
+    __atomic_store_n(&mldr_duprecs[idx].valid, 1, __ATOMIC_RELEASE);
+}
+
 /* sig-reentry diagnostic (DARLING_TRAP_LOG only): the last SIGILL frame seen per host
  * thread. Racy by design, nothing is printed on the hot path; the not-ours branch
  * below prints the previous and the current record. */
@@ -4901,7 +5005,36 @@
 #define MLDR_UCTX_RSP(u) ((uintptr_t)0)
 #endif
 MLDR_TRAP_WRAPPER(sigsys_handler)
-MLDR_TRAP_WRAPPER(sigill_handler)
+/* sigill_handler is the MLDR_TRAP_WRAPPER shape plus the duplicate diagnostics: per-thread depth (by tid), and after the inner handler
+ * a record when the duplicate count went up (the context is untouched by a duplicate, so rip and si_addr are still readable). The
+ * count is process-wide: a duplicate on another thread in the same window can be attributed here too (diagnostic only). */
+static void
+sigill_handler(int signo, siginfo_t *info, void *uctx_void)
+{
+    struct mldr_sigstk_hdr *h = mldr_cur_hdr();
+    uintptr_t prev = h ? h->trap_guest_rsp : 0;
+    long ht = 0;
+    int slot = 0, depth = 0;
+    unsigned long d0 = 0;
+    intptr_t delta = 0;
+    if (mldr_dupdiag_on < 0)
+        mldr_dupdiag_on = getenv("DARLING_SIG65_COUNT") != NULL;
+    if (h) h->trap_guest_rsp = MLDR_UCTX_RSP(uctx_void);
+    if (mldr_dupdiag_on) {
+        freebsd_raw_syscall(SYS_thr_self, (long)&ht, 0, 0, 0, 0, 0);
+        slot = (int)(ht & 63);
+        depth = __atomic_add_fetch(&mldr_sigill_depth[slot], 1, __ATOMIC_RELAXED);
+        d0 = __atomic_load_n(&mldr_sigill_dups, __ATOMIC_RELAXED);
+        delta = (intptr_t)info->si_addr - (intptr_t)((ucontext_t *)uctx_void)->uc_mcontext.mc_rip;
+    }
+    sigill_handler_inner(signo, info, uctx_void);
+    if (mldr_dupdiag_on) {
+        if (__atomic_load_n(&mldr_sigill_dups, __ATOMIC_RELAXED) != d0)
+            mldr_dupdiag_record((long)delta, depth > 1);
+        __atomic_sub_fetch(&mldr_sigill_depth[slot], 1, __ATOMIC_RELAXED);
+    }
+    if (h) h->trap_guest_rsp = prev;
+}
 
