+static unsigned long dserverRpcMs() {
+	struct timespec ts; clock_gettime(CLOCK_MONOTONIC, &ts);
+	return (unsigned long)ts.tv_sec * 1000UL + (unsigned long)ts.tv_nsec / 1000000UL;
+}
+static const char* dserverRpcAddr(const struct sockaddr_un& a) {
+	return a.sun_path[0] ? a.sun_path : (a.sun_path + 1);
+}
