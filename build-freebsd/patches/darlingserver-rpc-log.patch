 void DarlingServer::Call::sendReply(Message&& reply) {
+	if (dserverRpcLogOn()) {
+		int num = -1, code = 0;
+		if (reply.data().size() >= sizeof(dserver_rpc_replyhdr_t)) {
+			auto rh = reinterpret_cast<dserver_rpc_replyhdr_t*>(reply.data().data());
+			num = (int)rh->number; code = rh->code;
+		}
