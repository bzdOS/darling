 	if (_deferralState != DeferralState::NotDeferred) {
+		++dsdiag_dowork_deferred;
 		microthreadLog.debug() << _tid << "(" << _nstid << "): execution was deferred" << microthreadLog.endLog;
 		_deferralState = DeferralState::DeferredPending;
