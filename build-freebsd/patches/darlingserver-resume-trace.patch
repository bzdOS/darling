 };
 
 void DarlingServer::Thread::resume() {
+	++dsdiag_resume_calls;
 	{
 		std::shared_lock lock(_rwlock);
 		if (!_suspended) {
 			// maybe we should throw an error here?
+			++dsdiag_resume_early_not_suspended;
+			{
+				std::lock_guard<std::mutex> dl(dsdiagMutex);
+				dsdiagEarly.insert(this);
+			}
+			auto cur = currentThreadVar;
+			microthreadLog.debug() << "DIAG resume tid=" << _tid << " nstid=" << _nstid << " EARLY-not-suspended running=" << _running << " caller-tid=" << (cur ? cur->_tid : -1) << " ret=" << __builtin_return_address(0) << microthreadLog.endLog;
 			return;
 		}
 	}
+	++dsdiag_resume_scheduled;
+	{
+		std::lock_guard<std::mutex> dl(dsdiagMutex);
+		dsdiagEarly.erase(this);
+	}
+	microthreadLog.debug() << "DIAG resume tid=" << _tid << " nstid=" << _nstid << " scheduled ret=" << __builtin_return_address(0) << microthreadLog.endLog;
 
 	Server::sharedInstance().scheduleThread(shared_from_this());
 };
