 static const auto microthreadLog = DarlingServer::Log("microthread");
 
+// Diagnostic counters (no behaviour change); read from a debugger via the dsdiag_* globals.
+#define DSDIAG(n) std::atomic<unsigned long> dsdiag_##n{0};
+DSDIAG(resume_calls) DSDIAG(resume_early_not_suspended) DSDIAG(resume_scheduled)
+DSDIAG(suspend_calls) DSDIAG(suspend_after_early_resume)
+DSDIAG(dowork_calls) DSDIAG(dowork_deferred) DSDIAG(dowork_already_running) DSDIAG(dowork_terminating)
+DSDIAG(dowork_dead) DSDIAG(dowork_top_return) DSDIAG(dowork_resume_ctx) DSDIAG(dowork_no_pending_call) DSDIAG(dowork_new_call)
+#undef DSDIAG
+// threads that saw resume() while !_suspended and have not suspended/resumed since
+static std::mutex dsdiagMutex;
+static std::set<const void*> dsdiagEarly;
+
 // this runs in the context of the microthread (i.e. with the microthread's stack active)
 void DarlingServer::Thread::microthreadWorker() {
 #if DSERVER_ASAN
