+		microthreadLog.debug() << "DIAG suspend tid=" << _tid << " nstid=" << _nstid << " early-resume-seen=" << early << " continuation=" << (continuationCallback ? 1 : 0) << microthreadLog.endLog;
+	}
 
 	unlockMeWhenSuspending = unlockMe;
 
