diff --git a/darling/src/libsystem_kernel/emulation/src/xnu_syscall/bsd/impl/misc/mac_syscall.c b/darling/src/libsystem_kernel/emulation/src/xnu_syscall/bsd/impl/misc/mac_syscall.c
new file mode 100644
index 0000000..39b567a
--- /dev/null
+++ b/darling/src/libsystem_kernel/emulation/src/xnu_syscall/bsd/impl/misc/mac_syscall.c
@@ -0,0 +1,19 @@
+#include <darling/emulation/xnu_syscall/bsd/impl/misc/mac_syscall.h>
+
+#include <sys/errno.h>
+
+// __mac_syscall (381) as on macOS with no MAC policy of that name registered (xnu security/mac_base.c):
+// the policy name is copied in (MAC_MAX_POLICY_NAME = 32 bytes including the NUL; NULL -> EFAULT,
+// no NUL within 32 bytes -> ENAMETOOLONG as copyinstr), then no policy matches -> ENOPOLICY.
+#define DARLING_MAC_MAX_POLICY_NAME 32
+
+long sys_mac_syscall(const char* policy, int call, void* arg)
+{
+	(void)call; (void)arg;
+	if (policy == 0)
+		return -EFAULT;
+	for (int i = 0; i < DARLING_MAC_MAX_POLICY_NAME; i++)
+		if (policy[i] == '\0')
+			return -ENOPOLICY;
+	return -ENAMETOOLONG;
+}
