+// Full-rate DIAG resume ring. DSERVER_DIAG_RING=<entries> (darling.toml [env]; unset or 0: off) maps
+// <prefix>/private/var/log/dserver-diag-ring.bin MAP_SHARED, so the entries reach the file on any exit
+// (signal, _exit on lifetime-pipe EOF, SIGKILL) with no flush step. Layout: 64-byte header
+// {magic "DSDRING1", u64 capacity, u64 next index}, then capacity entries of 32 bytes
+// {u64 CLOCK_MONOTONIC ns, i32 tid, i32 nstid | kind<<28, u64 return address, u64 per-tid n or caller tid}.
+// kind 0 = scheduled, 1 = EARLY-not-suspended. build-freebsd/diag-ring-decode.py writes <run>-diag-ring.log.
+struct DsdiagRingEntry { uint64_t ns; int32_t tid; int32_t nstidKind; uint64_t ret; uint64_t n; };
+static DsdiagRingEntry* dsdiagRing = nullptr;
+static std::atomic<uint64_t>* dsdiagRingNext = nullptr;
+static uint64_t dsdiagRingCap = 0;
+static void dsdiagRingRecord(int kind, int tid, int nstid, const void* ret, uint64_t n) {
+	static std::once_flag once;
+	std::call_once(once, []() {
+		const char* e = getenv("DSERVER_DIAG_RING");
+		uint64_t cap = e ? strtoull(e, nullptr, 10) : 0;
+		if (cap == 0) return;
+		std::string path = DarlingServer::Server::sharedInstance().prefix() + "/private/var/log/dserver-diag-ring.bin";
+		int fd = open(path.c_str(), O_RDWR | O_CREAT | O_TRUNC | O_CLOEXEC, 0644);
+		if (fd < 0) return;
+		size_t len = 64 + cap * sizeof(DsdiagRingEntry);
+		if (ftruncate(fd, len) != 0) { close(fd); return; }
+		void* m = mmap(nullptr, len, PROT_READ | PROT_WRITE, MAP_SHARED, fd, 0);
+		close(fd);
+		if (m == MAP_FAILED) return;
+		memcpy(m, "DSDRING1", 8);
+		((uint64_t*)m)[1] = cap;
+		dsdiagRingNext = new (((uint64_t*)m) + 2) std::atomic<uint64_t>(0);
+		dsdiagRing = (DsdiagRingEntry*)((char*)m + 64);
+		dsdiagRingCap = cap;
+	});
+	if (!dsdiagRing) return;
+	uint64_t i = dsdiagRingNext->fetch_add(1, std::memory_order_relaxed);
+	struct timespec ts; clock_gettime(CLOCK_MONOTONIC, &ts);
+	DsdiagRingEntry& r = dsdiagRing[i % dsdiagRingCap];
+	r.ns = (uint64_t)ts.tv_sec * 1000000000ull + ts.tv_nsec;
+	r.tid = tid; r.nstidKind = (nstid & 0x0fffffff) | (kind << 28);
+	r.ret = (uint64_t)(uintptr_t)ret; r.n = n;
+}
