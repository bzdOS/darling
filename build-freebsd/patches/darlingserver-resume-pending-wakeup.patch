+void DarlingServer::Thread::resumeSelfTest() {
+	// Bursts of kernelAsync() lambdas: every enqueue wakes a runner through Thread::resume(), many while that
+	// runner is still running. A lost wakeup leaves lambdas unexecuted, which shows up as a timeout here.
+	const int rounds = 200, perRound = 64;
+	const int timeoutSec = 20;
+	std::atomic<int> done{0};
+	for (int r = 0; r < rounds; ++r) {
+		done = 0;
+		for (int i = 0; i < perRound; ++i) {
+			kernelAsync([&done]() { ++done; });
+		}
+		for (int waited = 0; done.load() < perRound; waited += 1) {
+			if (waited > timeoutSec * 1000) {
+				fprintf(stderr, "RESUME-SELFTEST FAIL: round %d executed %d/%d lambdas in %ds, absorbed=%lu early=%lu\n", r, done.load(), perRound, timeoutSec, dsdiag_suspend_absorbed_wakeup.load(), dsdiag_resume_early_not_suspended.load());
+				_exit(1);
+			}
+			usleep(1000);
+		}
+	}
+	fprintf(stderr, "RESUME-SELFTEST PASS: %d rounds x %d lambdas, early=%lu absorbed=%lu\n", rounds, perRound, dsdiag_resume_early_not_suspended.load(), dsdiag_suspend_absorbed_wakeup.load());
+	_exit(0);
+};
