diff --git a/gen/bsdsyscalls/___ulock_wait.S b/gen/bsdsyscalls/___ulock_wait.S
index df201ce..31cb32f 100644
--- a/gen/bsdsyscalls/___ulock_wait.S
+++ b/gen/bsdsyscalls/___ulock_wait.S
@@ -5,7 +5,30 @@
 #error "SYS_ulock_wait not defined. The header files libsyscall is building against do not match syscalls.master."
 #endif
 
-#if defined(__arm64__)
+#if defined(DARLING) && defined(__x86_64__)
+/*
+ * ULF_NO_ERRNO (0x1000000 in the operation) asks for the error as the negative return value.
+ * The generic stub sends every result in [-4095, -1] through cerror(), which returns -1 and sets errno,
+ * so such a caller read EPERM-like garbage. Keep the operation across the call and return the raw value
+ * when the flag is set.
+ */
+LEAF(___ulock_wait, 0)
+	subq	$16, %rsp
+	movq	%rdi, (%rsp)
+	movl	$ SYS_ulock_wait, %eax
+	call	__darling_bsd_syscall
+	movq	(%rsp), %rdi
+	addq	$16, %rsp
+	testl	$0x1000000, %edi
+	jnz	2f
+	cmpq	$-4095, %rax
+	jb	2f
+	movq	%rax, %rdi
+	negq	%rdi
+	BRANCH_EXTERN(_cerror_nocancel)
+2:
+	ret
+#elif defined(__arm64__)
 MI_ENTRY_POINT(___ulock_wait)
 SYSCALL_NONAME(ulock_wait, 4, cerror_nocancel)
 ret
