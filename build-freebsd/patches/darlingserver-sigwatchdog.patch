+	// (ki_siglist, ki_sigmask, ki_sigcatch, ki_sigignore for signal 65).
+	static uint64_t dsKinfoThreadState(pid_t pid, pid_t tid) {
+		int mib[4] = { CTL_KERN, KERN_PROC, KERN_PROC_PID | KERN_PROC_INC_THREAD, (int)pid };
+		size_t len = 0;
+		if (sysctl(mib, 4, nullptr, &len, nullptr, 0) != 0 || len == 0) {
+			return 4ull << 56;
+		}
+		std::vector<char> buf(len + 16 * sizeof(struct kinfo_proc));
+		len = buf.size();
+		if (sysctl(mib, 4, buf.data(), &len, nullptr, 0) != 0) {
+			return 4ull << 56;
+		}
+		size_t count = len / sizeof(struct kinfo_proc);
+		for (size_t i = 0; i < count; ++i) {
+			auto kp = reinterpret_cast<struct kinfo_proc*>(buf.data()) + i;
+			if (kp->ki_tid != (lwpid_t)tid) {
