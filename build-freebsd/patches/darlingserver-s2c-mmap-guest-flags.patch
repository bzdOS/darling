+// The S2C mmap request is executed by the guest through its Linux-ABI syscall layer, so its flags travel in
+// Linux numbering. The server builds them from host constants, which differ on non-Linux hosts
+// (e.g. MAP_ANONYMOUS is 0x20 on Linux but 0x1000 elsewhere): translate them, or an anonymous request
+// would be read as a file mapping of fd -1 and fail with EBADF.
+static int _guestMmapFlags(int hostFlags) {
+#ifdef DARLING_FREEBSD
+	return bsdos_mmap_flags_host_to_guest(hostFlags);
+#else
+	return hostFlags;
+#endif
+};
+
+// The reply's errno comes from the guest (Linux numbering); the server reasons in host errno values.
+static int _guestErrnoToHost(int guestErrno) {
+#ifdef DARLING_FREEBSD
+	return guestErrno ? bsdos_errno_guest_to_host(guestErrno) : 0;
+#else
+	return guestErrno;
+#endif
 };
 
