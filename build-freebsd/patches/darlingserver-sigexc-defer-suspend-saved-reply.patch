+
+// Suspend signal vs. a saved reply (sig-reentry livelock). When a thread is interrupted while the reply to the call
+// it waits in is already queued, the client pushes that reply back (push_reply) and the server re-sends it after
+// interrupt_exit. A thread_suspend that lands meanwhile (the suspender's next round, issued while the thread is still
+// in its handler) raised SIGRTMIN at once; the signal stayed masked in the handler and was delivered right after
+// sigreturn, before the client read the re-sent reply, so the next interrupt_enter pushed it back again and the
+// thread never returned to user code (progress=0 over 888 suspend rounds). XNU lets a thread whose wait has completed
+// reach user code first, so the suspend signal is held while the thread owns a saved reply and sent once the client
+// makes its next call (it has read the reply) or 2 ms after the re-send, whichever comes first.
+bool DarlingServer::Thread::deferSuspendSignal(int signal) {
+	if (signal != LINUX_SIGRTMIN) {
+		return false;
+	}
+	std::unique_lock lock(_rwlock);
+	bool holding = _savedReplyInFlight || _pendingSavedReply || (!_interrupts.empty() && _interrupts.top().savedReply);
+	if (!holding) {
+		return false;
+	}
+	_suspendSignalDeferred = true;
+	return true;
+};
+
+void DarlingServer::Thread::noteSavedReplyResent() {
+	uint64_t gen;
+	{
+		std::unique_lock lock(_rwlock);
+		_savedReplyInFlight = true;
+		gen = ++_savedReplyGen;
+	}
+	std::weak_ptr<Thread> weak = shared_from_this();
+	std::thread([weak, gen]() {
+		std::this_thread::sleep_for(std::chrono::milliseconds(2));
+		auto self = weak.lock();
+		if (!self) {
+			return;
+		}
+		bool send = false;
+		{
+			std::unique_lock lock(self->_rwlock);
+			if (self->_savedReplyGen != gen || !self->_savedReplyInFlight) {
+				return;
+			}
+			self->_savedReplyInFlight = false;
+			send = self->_suspendSignalDeferred;
+			self->_suspendSignalDeferred = false;
+		}
+		if (send) {
+			try { self->sendSignal(LINUX_SIGRTMIN); } catch (...) {}
+		}
+	}).detach();
+};
+
+void DarlingServer::Thread::noteCallReceived() {
+	bool send = false;
+	{
+		std::unique_lock lock(_rwlock);
+		if (!_savedReplyInFlight) {
+			return;
+		}
+		_savedReplyInFlight = false;
+		send = _suspendSignalDeferred;
+		_suspendSignalDeferred = false;
+	}
+	if (send) {
+		try { sendSignal(LINUX_SIGRTMIN); } catch (...) {}
+	}
+};
+
+void DarlingServer::Thread::flushDeferredSuspendSignal() {
+	bool send = false;
+	{
+		std::unique_lock lock(_rwlock);
+		if (_savedReplyInFlight || (!_interrupts.empty() && _interrupts.top().savedReply)) {
+			return;
+		}
+		send = _suspendSignalDeferred;
+		_suspendSignalDeferred = false;
+	}
+	if (send) {
+		try { sendSignal(LINUX_SIGRTMIN); } catch (...) {}
+	}
+};
