diff --git a/darling/src/libsystem_kernel/emulation/src/xnu_syscall/bsd/impl/xattr/fgetxattr.c b/darling/src/libsystem_kernel/emulation/src/xnu_syscall/bsd/impl/xattr/fgetxattr.c
index 6dca738..9e3b473 100644
--- a/darling/src/libsystem_kernel/emulation/src/xnu_syscall/bsd/impl/xattr/fgetxattr.c
+++ b/darling/src/libsystem_kernel/emulation/src/xnu_syscall/bsd/impl/xattr/fgetxattr.c
@@ -16,6 +16,9 @@ long sys_fgetxattr(int fd, const char* name, char* value,
 
 	ret = LINUX_SYSCALL(__NR_fgetxattr, fd, name, value, size);
 
+	// Linux ENODATA (61) means "no such attribute"; macOS callers expect ENOATTR.
+	if (ret == -61)
+		return -ENOATTR;
 	if (ret < 0)
 		return errno_linux_to_bsd(ret);
 
diff --git a/darling/src/libsystem_kernel/emulation/src/xnu_syscall/bsd/impl/xattr/getxattr.c b/darling/src/libsystem_kernel/emulation/src/xnu_syscall/bsd/impl/xattr/getxattr.c
