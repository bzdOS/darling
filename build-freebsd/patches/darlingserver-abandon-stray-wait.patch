+// Thread locked. The thread runs again although its wait is still pending (wait_result is THREAD_WAITING) and
+// TH_WAIT is gone: dtape_thread_entering() cleared it because the client thread started a new call. Nobody will
+// deliver a wakeup to this wait any more, and THREAD_WAITING is not a result (semaphore_block panicked on it):
+// take the thread off its waitq and finish the wait as interrupted.
+static wait_result_t dtape_abandon_pending_wait_locked(dtape_thread_t* thread) {
+	thread->xnu_thread.wait_result = THREAD_INTERRUPTED;
+	clear_wait_internal(&thread->xnu_thread, THREAD_INTERRUPTED);
+	return THREAD_INTERRUPTED;
+}
 
