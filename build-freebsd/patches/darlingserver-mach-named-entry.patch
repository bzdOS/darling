+// Records a mapping, first dropping every recorded mapping it overlaps (those can only be stale:
+// the new mapping replaced them, or they were unmapped by the guest, which does not tell us).
+static void dtape_map_replace_shared_entry(dtape_map_t* map, dtape_map_shared_entry_t* shared_entry) {
+	dtape_map_shared_entry_t* entry;
