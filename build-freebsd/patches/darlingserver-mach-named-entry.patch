+		dtape_mutex_lock(&target_map->shared_entry_lock);
+		RB_FOREACH(it, dtape_map_shared_entry_head, &target_map->shared_entries) {
+			if (it->address <= start && end <= it->address + it->size) {
+				found = it;
+				break;
+			}
+		}
+		if (found) {
+			descriptor = found->descriptor;
+			found_protection = found->protection;
+			dtape_map_shared_descriptor_retain(descriptor);
+			entry_offset = (found->page_offset * page_size) + (start - found->address);
+		}
+		dtape_mutex_unlock(&target_map->shared_entry_lock);
