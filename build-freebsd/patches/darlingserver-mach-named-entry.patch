+		return KERN_NOT_SUPPORTED;
+	}
+	if (flags == supported_flags || *size == 0 || *size + page_size < *size) {
+		return KERN_INVALID_ARGUMENT;
+	}
+
+	if (flags & MAP_MEM_NAMED_CREATE) {
+		if (parent_entry != IP_NULL || offset != 0) {
+			return KERN_INVALID_ARGUMENT;
+		}
+		entry_size = mach_vm_round_page(*size);
+
+		int memfd = memfd_create("darling-mach-entry", MFD_CLOEXEC);
+		if (memfd < 0) {
+			return KERN_RESOURCE_SHORTAGE;
+		}
+		if (ftruncate(memfd, entry_size) < 0) {
+			close(memfd);
+			return KERN_RESOURCE_SHORTAGE;
+		}
+		descriptor = dtape_map_shared_descriptor_create(memfd, entry_size);
+		if (!descriptor) {
+			close(memfd);
+			return KERN_RESOURCE_SHORTAGE;
+		}
+	} else if (parent_entry != IP_NULL) {
+		vm_named_entry_t parent = dtape_named_entry_from_port(parent_entry);
+		if (!parent) {
+			return KERN_INVALID_ARGUMENT;
+		}
+		if (offset & (page_size - 1)) {
+			return KERN_INVALID_ARGUMENT;
+		}
+		entry_size = mach_vm_round_page(*size);
+		if (offset > parent->size || entry_size > parent->size - offset) {
+			return KERN_INVALID_ARGUMENT;
+		}
+		if (prot & ~parent->protection) {
+			return KERN_PROTECTION_FAILURE;
+		}
+		entry_offset = parent->offset + offset;
+		descriptor = dtape_named_entry_descriptor(parent);
+		dtape_map_shared_descriptor_retain(descriptor);
