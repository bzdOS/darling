+//   MAP_MEM_VM_SHARE | prot or plain prot, parent NULL: window onto an address range of target_map
+//       that was itself mapped from a named entry (the usual "read-only copy of a writable region")
+//   any of the above with a parent entry: sub-window of the parent (page aligned offset)
+// Not supported: MAP_MEM_VM_COPY, purgable, ledger, caching modes, 'ONLY', data-address variants,
+// and VM_SHARE of memory that is not backed by a named entry (returns KERN_NOT_SUPPORTED).
+kern_return_t _mach_make_memory_entry(vm_map_t target_map, memory_object_size_t* size, memory_object_offset_t offset, vm_prot_t permission, ipc_port_t* object_handle, ipc_port_t parent_entry) {
+	const uint64_t page_size = sysconf(_SC_PAGESIZE);
+	const uint64_t supported_flags = MAP_MEM_NAMED_CREATE | MAP_MEM_VM_SHARE;
+	uint64_t flags = permission & MAP_MEM_FLAGS_MASK;
+	vm_prot_t prot = permission & VM_PROT_ALL;
+	dtape_map_shared_descriptor_t* descriptor = NULL;
+	uint64_t entry_offset = 0;
+	uint64_t entry_size = 0;
