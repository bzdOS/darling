+/* Threads whose fork() failed, keyed by their RPC socket (+1). The parent
+ * handler of a failed fork must not wait for a child that does not exist
+ * (see _mach_fork_parent). Consumed by exactly that call on the same thread. */
+#define FORK_FAILED_SLOTS 16
+static volatile int fork_failed_sockets[FORK_FAILED_SLOTS];
+
+static void fork_failed_mark(void)
+{
+	int key = __dserver_per_thread_socket() + 1;
+	for (int i = 0; i < FORK_FAILED_SLOTS; i++)
+		if (__sync_bool_compare_and_swap(&fork_failed_sockets[i], 0, key))
+			return;
+}
+
+int __darling_fork_failed_consume(void)
+{
+	int key = __dserver_per_thread_socket() + 1;
+	for (int i = 0; i < FORK_FAILED_SLOTS; i++)
+		if (__sync_bool_compare_and_swap(&fork_failed_sockets[i], key, 0))
+			return 1;
+	return 0;
+}
