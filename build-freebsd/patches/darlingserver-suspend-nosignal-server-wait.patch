+bool DarlingServer::Thread::suspendWithoutSignal() {
+	std::unique_lock lock(_rwlock);
+	// server-side wait = the client is blocked on an active call and our microthread is parked inside it;
+	// anything else (user code, signal handler, S2C in progress, dying) needs the signal
+	if (_dead || _terminating || !_activeCall || !_suspended || _interruptedForSignal || _processingSignal || _deferReplyForS2C || _suspendedNoSignal) {
+		return false;
+	}
+	_suspendedNoSignal = true;
+	dsdiagRingEvent(10, _tid, _nstid, 0); // suspend without signal
+	return true;
+};
+
+void DarlingServer::Thread::releaseHeld() {
+	std::unique_lock lock(_rwlock);
+	if (!_suspendedNoSignal) {
+		return;
+	}
+	_suspendedNoSignal = false;
+	bool had = _heldReply.has_value();
+	if (had) {
+		auto reply = std::move(*_heldReply);
+		_heldReply = std::nullopt;
+		if (_interruptedForSignal && !_interrupts.top().savedReply) {
+			_interrupts.top().savedReply = std::move(reply);
+		} else if (_deferReplyForS2C) {
+			_deferredReply = std::move(reply);
+		} else if (!_dead) {
+			Server::sharedInstance().sendMessage(std::move(reply));
+		}
+	}
+	dsdiagRingEvent(12, _tid, _nstid, had ? 1 : 0); // released (n 1 = a held reply was sent)
+};
