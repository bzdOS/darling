+- (NSSet *) allFontFamilyNames {
+    /* The family list comes from the CoreText implementation (the same one
+     * CTFontManagerCopyAvailableFontFamilyNames answers for every client), so
+     * this backend keeps no font list of its own. CoreText is already loaded
+     * by AppKit (NSFont uses CTFont*), hence the flat lookup rather than a
+     * link dependency of this bundle. */
+    CFArrayRef (*copyFamilies)(void) = (CFArrayRef(*)(void)) dlsym(
+            RTLD_DEFAULT, "CTFontManagerCopyAvailableFontFamilyNames");
+    NSMutableSet *result = [NSMutableSet set];
+    CFArrayRef families = copyFamilies ? copyFamilies() : NULL;
+    if (families != NULL) {
+        CFIndex i, count = CFArrayGetCount(families);
+        for (i = 0; i < count; i++) {
+            id name = (id) CFArrayGetValueAtIndex(families, i);
+            if ([name isKindOfClass: [NSString class]])
+                [result addObject: name];
+        }
+        CFRelease(families);
+    }
+    if ([result count] == 0)
+        [result addObject: @"Helvetica"];
+    return result;
+}
+
+- (NSArray *) fontTypefacesForFamilyName: (NSString *) name {
+    /* NSFontFamily +addFontFamilyWithName: asks for this right after
+     * -allFontFamilyNames, once per family. One regular face per family. */
+    NSFontTypeface *face = [[[NSFontTypeface alloc] initWithName: name
+                                                       traitName: @"Regular"
+                                                          traits: 0]
+            autorelease];
+    return [NSArray arrayWithObject: face];
+}
