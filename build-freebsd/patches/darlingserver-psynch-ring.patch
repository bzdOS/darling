+enum { PSR_OP_THREAD_PARK = 16, PSR_OP_THREAD_UNPARK = 17, PSR_RES_WAIT = 1, PSR_RES_DONE = 4, PSR_BIT_PARK = 2 };
+
+static const bool dsPsynchRingInit = [] {
+	const char* on = getenv("DSERVER_PSYNCH_RING");
+	if (!on || !*on || *on == '0') {
+		return false;
+	}
+	unsigned long n = 4096;
+	if (const char* sz = getenv("DSERVER_PSYNCH_RING_SIZE")) {
+		n = strtoul(sz, nullptr, 0);
+	}
+	if (n < 16) {
+		n = 16;
+	}
+	if (n > (1ul << 22)) {
+		n = (1ul << 22);
+	}
+	while (n & (n - 1)) {
+		n &= n - 1;
+	}
+	// classes: bit 0 psynch, bit 1 park/unpark, bit 2 suspend/resume
+	unsigned long mask = 7;
+	if (const char* cl = getenv("DSERVER_PSYNCH_RING_CLASSES")) {
+		mask = strtoul(cl, nullptr, 0) & 7;
+	}
+	bool any = false;
+	for (int c = 0; c < 3; c++) {
+		if (!(mask & (1ul << c))) {
+			continue;
+		}
+		// 128 bytes per entry (see duct-tape/internal-include/darlingserver/duct-tape/psynch-ring.h); never freed
+		void* mem = calloc(n, 128);
+		if (mem) {
+			dtape_psynch_ring_attach(c, mem, (uint32_t)n);
+			any = true;
+		}
+	}
+	return any;
+}();
