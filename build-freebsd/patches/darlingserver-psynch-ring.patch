index 0000000..ba68286
--- /dev/null
+++ b/duct-tape/internal-include/darlingserver/duct-tape/psynch-ring.h
@@ -0,0 +1,85 @@
+#ifndef _DARLINGSERVER_DUCT_TAPE_PSYNCH_RING_H_
+#define _DARLINGSERVER_DUCT_TAPE_PSYNCH_RING_H_
+
+// In-memory rings of psynch (pthread mutex / cond / rwlock) events, of thread park/unpark events and of thread
+// suspend/resume events: one ring per class, so a busy class cannot push out another one.
+// Off by default; the server enables it with DSERVER_PSYNCH_RING=1 (DSERVER_PSYNCH_RING_SIZE=<entries per ring>,
+// default 4096; DSERVER_PSYNCH_RING_CLASSES=<mask>, bit 0 psynch, bit 1 park/unpark, bit 2 suspend/resume,
+// default 7). Nothing is logged: the buffers are read out of the live process (ds_microthreads_dump.py, section
+// "psynch ring"). dtape_psynch_ring_on holds the mask of the classes that are on; when a class is off the cost of
+// its hook is one load and one branch. Each class counts recorded entries and dropped (overwritten) entries.
+
+#include <stdint.h>
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+// one entry is exactly 128 bytes, little endian; seq is written last, 0 means empty slot
+struct dtape_psynch_ring_ent {
+	uint64_t seq;       //   0: 1-based global event number
+	uint64_t ts;        //   8: mach_absolute_time() (ns)
+	uint64_t uaddr;     //  16: user address of the lock / cv (0 for thread events)
+	uint32_t tid;       //  24: caller (guest thread id)
+	uint16_t op;        //  28: DTAPE_PSR_OP_*
+	uint16_t res;       //  30: DTAPE_PSR_RES_*
+	uint32_t l0, u0, s0; //  32: kwq lword/uword/sword before
+	uint32_t l1, u1, s1; //  44: kwq lword/uword/sword after
+	uint32_t arg0, arg1; //  56: op specific (see below)
+	uint16_t type;      //  64: kwq type (1 mutex, 2 cond, 4 rwlock), 0 for thread events
+	uint8_t qr, qw;     //  66: waiters in the read / write queue (saturating)
+	uint16_t nwake, nskip; // 68: threads woken / found no longer waiting (full counts)
+	uint32_t wake[6];   //  72: first woken guest thread ids
+	uint32_t skip[6];   //  96: first skipped guest thread ids
+	uint64_t aux;       // 120: op specific
+};
+
+// arg0/arg1/aux per op:
+//  RD_LOCK WR_LOCK RW_UNLOCK: arg0=lgenval arg1=ugenval aux=rw_wc | flags<<32
+//  RW_HANDLE_UNLOCK: arg0=rwtype arg1=flags aux=rw_wc | updatebits<<32
+//  MTX_WAIT MTX_DROP: arg0=mgen arg1=ugen aux=tid hint (wait) / returnbits (drop)
+//  CV_WAIT: arg0=cgen arg1=cugen aux=mgen|mugen<<32 ; CV_SIGNAL/CV_BROAD: arg0=cgen arg1=cugen aux=csgen|updatebits<<32
+//  *_CONT (a waiter coming back): arg0=errno arg1=return value
+//  THREAD_SUSPEND/THREAD_RESUME (thread_suspend/thread_resume): tid=caller arg0=target arg1=user_stop_count after
+//     aux=suspend_count after | result code<<32
+//  THREAD_PARK (suspend hook, before Thread::suspend): tid=thread arg0=1 if a continuation is used; the call may still
+//     absorb an earlier resume and return without parking
+//  THREAD_UNPARK (resume hook, before Thread::resume): tid=caller arg0=target
+enum {
+	DTAPE_PSR_OP_RD_LOCK = 1, DTAPE_PSR_OP_WR_LOCK, DTAPE_PSR_OP_RW_UNLOCK, DTAPE_PSR_OP_RW_HANDLE_UNLOCK,
+	DTAPE_PSR_OP_RD_CONT, DTAPE_PSR_OP_WR_CONT, DTAPE_PSR_OP_MTX_WAIT, DTAPE_PSR_OP_MTX_DROP, DTAPE_PSR_OP_MTX_CONT,
+	DTAPE_PSR_OP_CV_WAIT, DTAPE_PSR_OP_CV_SIGNAL, DTAPE_PSR_OP_CV_BROAD, DTAPE_PSR_OP_CV_CONT,
+	DTAPE_PSR_OP_THREAD_SUSPEND, DTAPE_PSR_OP_THREAD_RESUME, DTAPE_PSR_OP_THREAD_PARK, DTAPE_PSR_OP_THREAD_UNPARK,
+};
+enum {
+	DTAPE_PSR_RES_WAIT = 1, // caller is about to block
+	DTAPE_PSR_RES_GRANTED,  // call returned without blocking
+	DTAPE_PSR_RES_WOKEN,    // waiter returned after a wakeup
+	DTAPE_PSR_RES_DONE,     // unlock / drop / signal completed
+	DTAPE_PSR_RES_ERROR,    // waiter returned with an error (interrupt, timeout)
+	DTAPE_PSR_RES_PREPOST,  // unlock recorded as a prepost, nobody woken
+	DTAPE_PSR_RES_SPURIOUS, // unlock ignored: older than the last unlock
+};
+
+enum { DTAPE_PSR_CLASS_PSYNCH = 0, DTAPE_PSR_CLASS_PARK = 1, DTAPE_PSR_CLASS_SUSP = 2, DTAPE_PSR_NCLASS = 3 };
+#define DTAPE_PSR_BIT(c) (1 << (c))
+
+// bit mask of the classes that are on (0: ring off)
+extern int dtape_psynch_ring_on;
+// per class: ring memory, entries (power of two), recorded entries (events offered while on), dropped entries (overwritten)
+extern struct dtape_psynch_ring_ent* dtape_psynch_ring_mem[DTAPE_PSR_NCLASS];
+extern uint32_t dtape_psynch_ring_size[DTAPE_PSR_NCLASS];
+extern uint64_t dtape_psynch_ring_head[DTAPE_PSR_NCLASS];
+extern uint64_t dtape_psynch_ring_dropped[DTAPE_PSR_NCLASS];
+
+// mem must hold n entries (zeroed); n is rounded down to a power of two by the caller; seq is per class
+void dtape_psynch_ring_attach(int cls, struct dtape_psynch_ring_ent* mem, uint32_t n);
+void dtape_psynch_ring_rec(const struct dtape_psynch_ring_ent* e);
+// simple form for events without kwq state
+void dtape_psynch_ring_note(uint16_t op, uint16_t res, uint32_t tid, uint32_t arg0, uint32_t arg1, uint64_t aux);
+
+#ifdef __cplusplus
+}
+#endif
+
+#endif // _DARLINGSERVER_DUCT_TAPE_PSYNCH_RING_H_
