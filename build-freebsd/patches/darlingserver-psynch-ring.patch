+// psynch ring (duct-tape/src/psynch.c): off unless DSERVER_PSYNCH_RING is set
+extern "C" {
+	extern int dtape_psynch_ring_on;
+	void dtape_psynch_ring_attach(int cls, void* mem, uint32_t n);
