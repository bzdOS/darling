+/* ---- psynch ring hooks (darlingserver/duct-tape/psynch-ring.h); each is one branch when the ring is off ---- */
+#define PSR_ON() __builtin_expect((dtape_psynch_ring_on & DTAPE_PSR_BIT(DTAPE_PSR_CLASS_PSYNCH)) != 0, 0)
+
+struct psr_st { uint32_t l, u, s; };
+struct psr_acc { uint16_t nwake, nskip; uint32_t wake[6], skip[6]; };
+static __thread struct psr_acc psr_acc;
+
+static inline void
+psr_snap(ksyn_wait_queue_t kwq, struct psr_st *st)
+{
+	st->l = kwq->kw_lword;
+	st->u = kwq->kw_uword;
+	st->s = kwq->kw_sword;
+}
+
+static inline void
+psr_acc_reset(void)
+{
+	__builtin_memset(&psr_acc, 0, sizeof(psr_acc));
+}
+
+static void
+psr_acc_add(uint64_t tid, int woken)
+{
+	if (woken) {
+		if (psr_acc.nwake < 6) psr_acc.wake[psr_acc.nwake] = (uint32_t)tid;
+		psr_acc.nwake++;
+	} else {
+		if (psr_acc.nskip < 6) psr_acc.skip[psr_acc.nskip] = (uint32_t)tid;
+		psr_acc.nskip++;
+	}
+}
+
+/* before == NULL: the state did not change (before = after). use_acc takes and clears the wakeup lists */
+static void
+psr_emit(int op, int res, ksyn_wait_queue_t kwq, const struct psr_st *before,
+		uint32_t a0, uint32_t a1, uint64_t aux, int use_acc)
+{
+	struct dtape_psynch_ring_ent e;
+	__builtin_memset(&e, 0, sizeof(e));
+	e.uaddr = kwq->kw_addr;
+	e.tid = (uint32_t)thread_tid(current_thread());
+	e.op = op;
+	e.res = res;
+	e.l1 = kwq->kw_lword; e.u1 = kwq->kw_uword; e.s1 = kwq->kw_sword;
+	e.l0 = before ? before->l : e.l1; e.u0 = before ? before->u : e.u1; e.s0 = before ? before->s : e.s1;
+	e.arg0 = a0; e.arg1 = a1; e.aux = aux;
+	e.type = kwq->kw_type & 0xff;
+	e.qr = kwq->kw_ksynqueues[KSYN_QUEUE_READ].ksynq_count > 255 ? 255 : kwq->kw_ksynqueues[KSYN_QUEUE_READ].ksynq_count;
+	e.qw = kwq->kw_ksynqueues[KSYN_QUEUE_WRITE].ksynq_count > 255 ? 255 : kwq->kw_ksynqueues[KSYN_QUEUE_WRITE].ksynq_count;
+	if (use_acc) {
+		e.nwake = psr_acc.nwake;
+		e.nskip = psr_acc.nskip;
+		__builtin_memcpy(e.wake, psr_acc.wake, sizeof(e.wake));
+		__builtin_memcpy(e.skip, psr_acc.skip, sizeof(e.skip));
+		psr_acc_reset();
+	}
+	dtape_psynch_ring_rec(&e);
+}
+
 #define TID_ZERO (uint64_t)0
