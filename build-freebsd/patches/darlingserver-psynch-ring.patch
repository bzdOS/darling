diff --git a/duct-tape/src/psynch.c b/duct-tape/src/psynch.c
index 748d083..9346ad7 100644
--- a/duct-tape/src/psynch.c
+++ b/duct-tape/src/psynch.c
@@ -678 +678,60 @@ void dtape_psynch_thread_destroy(dtape_thread_t* thread) {
 };
+
+// ---- psynch ring (see darlingserver/duct-tape/psynch-ring.h) -------------------------------------------------------
+
+#include <darlingserver/duct-tape/psynch-ring.h>
+
+int dtape_psynch_ring_on = 0;
+struct dtape_psynch_ring_ent* dtape_psynch_ring_mem[DTAPE_PSR_NCLASS];
+uint32_t dtape_psynch_ring_size[DTAPE_PSR_NCLASS];
+uint64_t dtape_psynch_ring_head[DTAPE_PSR_NCLASS];
+uint64_t dtape_psynch_ring_dropped[DTAPE_PSR_NCLASS];
+
+static int dtape_psynch_ring_class_of(uint16_t op) {
+	if (op == DTAPE_PSR_OP_THREAD_PARK || op == DTAPE_PSR_OP_THREAD_UNPARK) {
+		return DTAPE_PSR_CLASS_PARK;
+	}
+	if (op == DTAPE_PSR_OP_THREAD_SUSPEND || op == DTAPE_PSR_OP_THREAD_RESUME) {
+		return DTAPE_PSR_CLASS_SUSP;
+	}
+	return DTAPE_PSR_CLASS_PSYNCH;
+};
+
+void dtape_psynch_ring_attach(int cls, struct dtape_psynch_ring_ent* mem, uint32_t n) {
+	if (cls < 0 || cls >= DTAPE_PSR_NCLASS || mem == NULL || n == 0) {
+		return;
+	}
+	dtape_psynch_ring_mem[cls] = mem;
+	dtape_psynch_ring_size[cls] = n;
+	__atomic_fetch_or(&dtape_psynch_ring_on, DTAPE_PSR_BIT(cls), __ATOMIC_RELEASE);
+};
+
+void dtape_psynch_ring_rec(const struct dtape_psynch_ring_ent* e) {
+	int cls = dtape_psynch_ring_class_of(e->op);
+	if (!(dtape_psynch_ring_on & DTAPE_PSR_BIT(cls))) {
+		return;
+	}
+	uint64_t n = __atomic_fetch_add(&dtape_psynch_ring_head[cls], 1, __ATOMIC_RELAXED);
+	struct dtape_psynch_ring_ent* slot = &dtape_psynch_ring_mem[cls][n & (dtape_psynch_ring_size[cls] - 1)];
+	if (__atomic_exchange_n(&slot->seq, 0, __ATOMIC_RELAXED) != 0) {
+		__atomic_fetch_add(&dtape_psynch_ring_dropped[cls], 1, __ATOMIC_RELAXED);
+	}
+	*slot = *e;
+	slot->ts = mach_absolute_time();
+	__atomic_store_n(&slot->seq, n + 1, __ATOMIC_RELEASE);
+};
+
+void dtape_psynch_ring_note(uint16_t op, uint16_t res, uint32_t tid, uint32_t arg0, uint32_t arg1, uint64_t aux) {
+	if (!(dtape_psynch_ring_on & DTAPE_PSR_BIT(dtape_psynch_ring_class_of(op)))) {
+		return;
+	}
+	struct dtape_psynch_ring_ent e;
+	__builtin_memset(&e, 0, sizeof(e));
+	e.tid = tid;
+	e.op = op;
+	e.res = res;
+	e.arg0 = arg0;
+	e.arg1 = arg1;
+	e.aux = aux;
+	dtape_psynch_ring_rec(&e);
+};
