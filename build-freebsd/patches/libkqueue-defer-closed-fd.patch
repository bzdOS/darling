diff --git a/src/common/kqueue.c b/src/common/kqueue.c
index 61cc9dc..baaca1b 100644
--- a/src/common/kqueue.c
+++ b/src/common/kqueue.c
@@ -16,6 +16,7 @@
 
 #include <errno.h>
 #include <fcntl.h>
+#include <poll.h>
 #include <signal.h>
 #include <stdlib.h>
 #include <stdio.h>
@@ -110,8 +111,37 @@ kqueue_cmp(struct kqueue *a, struct kqueue *b)
 }
 #endif
 
+static pthread_mutex_t kq_pend_mtx = PTHREAD_MUTEX_INITIALIZER;
+
+/* Must hold the kq lock. Removes the fds whose close was deferred by kqueue_closed_fd(). */
+void kqueue_drain_closed(struct kqueue* kq)
+{
+    for (;;) {
+        int fd;
+        pthread_mutex_lock(&kq_pend_mtx);
+        if (kq->kq_pend_n == 0) {
+            pthread_mutex_unlock(&kq_pend_mtx);
+            return;
+        }
+        fd = kq->kq_pend_fds[--kq->kq_pend_n];
+        pthread_mutex_unlock(&kq_pend_mtx);
+
+        struct kevent64_s ev[2];
+        memset(ev, 0, sizeof(ev));
+        ev[0].ident = fd;
+        ev[0].flags = EV_DELETE | EV_RECEIPT;
+        ev[0].filter = EVFILT_READ;
+        ev[1].ident = fd;
+        ev[1].flags = EV_DELETE | EV_RECEIPT;
+        ev[1].filter = EVFILT_WRITE;
+        kevent_copyin_one(kq, &ev[0]);
+        kevent_copyin_one(kq, &ev[1]);
+    }
+}
+
 void kqueue_cleanup(struct kqueue* kq)
 {
+    kqueue_drain_closed(kq);
     struct knote *next, *tmp;
     for (next = kq->kq_tofree.lh_first; next != NULL; next = tmp)
     {
@@ -132,6 +162,7 @@ void
 kqueue_free(struct kqueue *kq)
 {
 	kqueue_cleanup(kq);
+	free(kq->kq_pend_fds);
 	// XXX: we should be doing this more efficiently (i.e. without walking through all open kqueues)
 	map_foreach(kqmap, kqueue_free_cb, kq);
     filter_unregister_all(kq);
@@ -244,11 +275,45 @@ kqueue_closed_fd(int fd)
 	for (size_t i = 0; i < context.kq_count; ++i) {
 		struct kqueue* kq = context.kqs_to_check[i];
 
-		kqueue_lock(kq);
-		// we don't care whether these operations succeed or not
-		kevent_copyin_one(kq, &ev[0]);
-		kevent_copyin_one(kq, &ev[1]);
-		kqueue_unlock(kq);
+		// A thread inside kevent64 holds the kq lock while a filter's copyout waits on the server, so a
+		// blocking lock here would stall close() of any fd for as long as that wait lasts. Ordinary
+		// contention is short and the fd should be gone from the kqueue when close() returns (no event for
+		// a closed fd), so retry for a bounded time; if the lock is still busy, queue the fd and the holder
+		// removes it when it is done (kqueue_cleanup).
+		bool locked = kqueue_trylock(kq);
+		for (int tries = 0; !locked && tries < 20 && !kq->kq_pend_n; ++tries) {
+			// (a non-empty queue means an earlier close already found the holder stuck: do not wait again)
+			poll(NULL, 0, 1);
+			locked = kqueue_trylock(kq);
+		}
+		if (locked) {
+			// we don't care whether these operations succeed or not
+			kevent_copyin_one(kq, &ev[0]);
+			kevent_copyin_one(kq, &ev[1]);
+			kqueue_drain_closed(kq);
+			kqueue_unlock(kq);
+		} else {
+			bool queued = false;
+			pthread_mutex_lock(&kq_pend_mtx);
+			if (kq->kq_pend_n == kq->kq_pend_cap) {
+				size_t ncap = kq->kq_pend_cap ? kq->kq_pend_cap * 2 : 16;
+				int* nbuf = realloc(kq->kq_pend_fds, ncap * sizeof(int));
+				if (nbuf) {
+					kq->kq_pend_fds = nbuf;
+					kq->kq_pend_cap = ncap;
+				}
+			}
+			if (kq->kq_pend_n < kq->kq_pend_cap) {
+				kq->kq_pend_fds[kq->kq_pend_n++] = fd;
+				queued = true;
+			}
+			pthread_mutex_unlock(&kq_pend_mtx);
+			// the holder may have finished before the fd was queued; if the lock is free now, drain
+			if (queued && kqueue_trylock(kq)) {
+				kqueue_drain_closed(kq);
+				kqueue_unlock(kq);
+			}
+		}
 	}
 
 	// now release the references we added
