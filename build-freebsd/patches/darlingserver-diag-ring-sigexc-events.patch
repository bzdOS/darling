+			sigThread->sendSignal(signal);
+			// Watchdog: the host kernel sometimes drops the signal when it lands while the thread leaves the previous
+			// handler (seen: the 7th of 7 signals never reached the guest trampoline, the suspender waited forever).
+			// Re-send every 25 ms until the handler reaches the server (thread_suspended), the thread parked, or the
+			// suspend was undone. A duplicate is harmless: its handler re-checks the suspend count.
+			std::weak_ptr<DarlingServer::Thread> weak = sigThread->weak_from_this();
+			uint64_t base = sigThread->_suspendedCalls.load();
+			uint64_t baseEnter = sigThread->_interruptEnters.load();
+			std::thread([weak, base, baseEnter, signal]() {
+				// backoff 25, 100, 400 ms (then 400): a slow handler (debug log, trace) must not get duplicate signals
+				for (int i = 1; i <= 200; i++) {
+					std::this_thread::sleep_for(std::chrono::milliseconds(i == 1 ? 25 : (i == 2 ? 100 : 400)));
+					auto t = weak.lock();
+					if (!t || t->isDead() || !t->_dtapeThread) {
+						return;
+					}
+					if (t->_suspendedCalls.load() != base || !dtape_thread_suspend_unacked(t->_dtapeThread)) {
+						return;
+					}
+					if (t->_interruptEnters.load() != baseEnter) {
+						// a handler is running (interrupt_enter seen): the signal was delivered, only slow
+						dsdiagRingEvent(14, t->_tid, t->_nstid, 0);
+						return;
+					}
+					dsdiagRingEvent(14, t->_tid, t->_nstid, (uint64_t)i); // suspend signal re-sent
+					try {
+						t->sendSignal(signal);
+					} catch (...) {
+						return;
+					}
+				}
+			}).detach();
 			return 0;
 		} catch (std::system_error e) {
 			return -e.code().value();
 		}
 	};
 
