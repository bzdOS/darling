+
+// Sigexc/RPC events for the diag ring (DSERVER_DIAG_RING); ret is 0 for these kinds.
+// 3 = saved reply re-sent at interrupt_exit, 4 = client-pushed reply saved (n 1 = pending, 0 = normal),
+// 5 = signal sent via duct-tape (n = signal), 8 = call received (n = call number),
+// 9 = reply put in the outbox (tid -1, n = reply number).
+// Per-thread last-event table, never overwritten by ring wrap-around: a page-aligned region after the ring in
+// the same file; header u64 [3] = its offset, u64 [4] = its slot count. Slot (64 bytes), keyed by tid (linear probe):
+// {i32 tid, i32 nstid, u64 last ns, u32 last kind, u32 pad, u64 last n, u64 last call number, u64 last call ns,
+//  u64 last signal ns, u64 events}. A thread stuck in a call keeps that call as "last call" with its time.
+struct DsdiagLastSlot {
+	std::atomic<int32_t> tid; int32_t nstid; uint64_t ns; uint32_t kind; uint32_t pad; uint64_t n;
+	uint64_t callNum; uint64_t callNs; uint64_t sigNs; uint64_t events;
+	// 64..127: suspend handshake — signal held (6) / released (7) last time and count, last thread_suspended call (n 23)
+	uint64_t heldNs; uint64_t heldCount; uint64_t releasedNs; uint64_t releasedCount; uint64_t suspendedNs; uint64_t suspendedCount; uint64_t sigCount; uint64_t pad2;
+};
+static_assert(sizeof(DsdiagLastSlot) == 128, "slot size");
+static DsdiagLastSlot* dsdiagLast = nullptr;
+static const uint64_t dsdiagLastSlots = 1024;
+
+static void dsdiagLastRecord(int kind, int tid, int nstid, uint64_t n) {
+	static std::once_flag once;
+	std::call_once(once, []() {
+		if (!dsdiagRing) return;
+		std::string path = DarlingServer::Server::sharedInstance().prefix() + "/private/var/log/dserver-diag-ring.bin";
+		int fd = open(path.c_str(), O_RDWR | O_CLOEXEC);
+		if (fd < 0) return;
+		uint64_t off = (64 + dsdiagRingCap * sizeof(DsdiagRingEntry) + 4095) & ~4095ull;
+		size_t len = dsdiagLastSlots * sizeof(DsdiagLastSlot);
+		if (ftruncate(fd, off + len) != 0) { close(fd); return; }
+		void* m = mmap(nullptr, len, PROT_READ | PROT_WRITE, MAP_SHARED, fd, off);
+		close(fd);
+		if (m == MAP_FAILED) return;
+		uint64_t* hdr = (uint64_t*)((char*)dsdiagRing - 64);
+		hdr[4] = dsdiagLastSlots;
+		hdr[6] = sizeof(DsdiagLastSlot);
+		hdr[3] = off;
+		dsdiagLast = (DsdiagLastSlot*)m;
+	});
+	if (!dsdiagLast || tid < 0) return;
+	for (uint64_t k = 0; k < dsdiagLastSlots; k++) {
+		DsdiagLastSlot& sl = dsdiagLast[((uint64_t)tid + k) % dsdiagLastSlots];
+		int32_t cur = sl.tid.load(std::memory_order_relaxed);
+		if (cur == 0) {
+			int32_t z = 0;
+			if (!sl.tid.compare_exchange_strong(z, tid) && z != tid) continue;
+		} else if (cur != tid) {
+			continue;
+		}
+		struct timespec ts; clock_gettime(CLOCK_MONOTONIC, &ts);
+		uint64_t ns = (uint64_t)ts.tv_sec * 1000000000ull + ts.tv_nsec;
+		sl.nstid = nstid; sl.ns = ns; sl.kind = kind; sl.n = n; sl.events++;
+		if (kind == 8) { sl.callNum = n; sl.callNs = ns; }
+		if (kind == 5) { sl.sigNs = ns; sl.sigCount++; }
+		if (kind == 6) { sl.heldNs = ns; sl.heldCount++; }
+		if (kind == 7) { sl.releasedNs = ns; sl.releasedCount++; }
+		if (kind == 8 && n == 23) { sl.suspendedNs = ns; sl.suspendedCount++; }
+		return;
+	}
+	// table full: never overwrite another thread's slot; count the dropped event in header u64[5]
+	__atomic_fetch_add((uint64_t*)((char*)dsdiagRing - 64) + 5, 1, __ATOMIC_RELAXED);
+}
+
+uint64_t dsdiagAddrHash(const struct sockaddr_un* addr) {
+	uint64_t h = 1469598103934665603ull;
+	if (addr) {
+		for (size_t i = 0; i < sizeof(addr->sun_path) && addr->sun_path[i]; ++i) {
+			h = (h ^ (unsigned char)addr->sun_path[i]) * 1099511628211ull;
+		}
+	}
+	return h;
+};
+
+void dsdiagRingEventRet(int kind, int tid, int nstid, uint64_t ret, uint64_t n) {
+	dsdiagRingRecord(kind, tid, nstid, reinterpret_cast<const void*>(ret), n);
+};
+
+void dsAckPushReply(int fd) {
+	// SIGPIPE blocked on this thread only (an SIG_IGN would be inherited by the guest processes the server spawns); a SIGPIPE raised by
+	// the write stays pending for this thread and is consumed with sigtimedwait before the mask is restored.
+	sigset_t pipeSet, oldSet;
+	sigemptyset(&pipeSet);
+	sigaddset(&pipeSet, SIGPIPE);
+	pthread_sigmask(SIG_BLOCK, &pipeSet, &oldSet);
+	char tmp = 1;
+	ssize_t r;
+	do {
+		r = write(fd, &tmp, sizeof(tmp));
+	} while (r < 0 && errno == EINTR);
+	if (r < 0) {
+		int err = errno;
+		if (err == EPIPE) {
+			struct timespec zero = { 0, 0 };
+			while (sigtimedwait(&pipeSet, nullptr, &zero) == SIGPIPE) {
+			}
+		}
+		dsdiagRingEvent(14, -1, -1, (8ull << 56) | (uint64_t)err); // ring kind 14 sub 8: ack write failed (32 = EPIPE: the client is gone)
+	}
+	pthread_sigmask(SIG_SETMASK, &oldSet, nullptr);
+	close(fd);
+}
+
+void dsdiagRingEvent(int kind, int tid, int nstid, uint64_t n) {
+	dsdiagRingRecord(kind, tid, nstid, nullptr, n);
+	dsdiagLastRecord(kind, tid, nstid, n);
+}
