+	}
+	cmsg = (const dserver_rpc_hooks_cmsghdr_t*)msg->msg_control;
+	if (cmsg->cmsg_len == 0 && cmsg->cmsg_level == 0 && cmsg->cmsg_type == 0) {
+		// the re-armed header was left untouched: no ancillary data
+		return 0;
+	}
