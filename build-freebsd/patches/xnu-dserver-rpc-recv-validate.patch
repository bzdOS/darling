+__attribute__((unused)) static long int dserver_rpc_hooks_received_fd_count(const dserver_rpc_hooks_msghdr_t* msg) {
+	const dserver_rpc_hooks_cmsghdr_t* cmsg;
+	size_t hdr = DSERVER_RPC_HOOKS_CMSG_LEN(0);
+	size_t payload;
