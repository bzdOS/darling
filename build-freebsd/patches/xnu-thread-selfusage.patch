index 0000000..2e61b04
--- /dev/null
+++ b/darling/src/libsystem_kernel/emulation/include/xnu_syscall/bsd/impl/misc/thread_selfusage.h
@@ -0,0 +1,9 @@
+#ifndef LINUX_THREAD_SELFUSAGE_H
+#define LINUX_THREAD_SELFUSAGE_H
+
+#include <stdint.h>
+
+// BSD syscall 482: CPU time used by the calling thread, in mach absolute time units (nanoseconds here).
+uint64_t sys_thread_selfusage(void);
+
+#endif // LINUX_THREAD_SELFUSAGE_H
diff --git a/darling/src/libsystem_kernel/emulation/src/xnu_syscall/bsd/impl/misc/thread_selfusage.c b/darling/src/libsystem_kernel/emulation/src/xnu_syscall/bsd/impl/misc/thread_selfusage.c
new file mode 100644
index 0000000..375d005
--- /dev/null
+++ b/darling/src/libsystem_kernel/emulation/src/xnu_syscall/bsd/impl/misc/thread_selfusage.c
@@ -0,0 +1,19 @@
+#include <darling/emulation/xnu_syscall/bsd/impl/misc/thread_selfusage.h>
+
+#include <darling/emulation/common/base.h>
+#include <darling/emulation/linux_premigration/linux-syscalls/linux.h>
+
+#define LINUX_CLOCK_THREAD_CPUTIME_ID 3
+
+struct thread_selfusage_ts { long tv_sec; long tv_nsec; };
+
+VISIBLE // made visible for xtrace
+uint64_t sys_thread_selfusage(void)
+{
+	struct thread_selfusage_ts ts;
+
+	// xnu returns 0 on failure to read the runtime, never an errno
+	if (LINUX_SYSCALL(__NR_clock_gettime, LINUX_CLOCK_THREAD_CPUTIME_ID, &ts) < 0)
+		return 0;
+	return (uint64_t)ts.tv_sec * 1000000000ull + (uint64_t)ts.tv_nsec;
+}
