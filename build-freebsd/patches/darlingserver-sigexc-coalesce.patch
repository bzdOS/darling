+// Copy of the wait loop of dtape_thread_wait_while_user_suspended for interrupt_exit of a suspend handler (kept apart so the
+// thread-suspend-lock patch stays independent): when the suspend count is zero it also ends the suspend signal's in-flight state,
+// under the same lock, so a later suspend sends a signal again; a suspend that arrived while the handler was in flight parks here.
+bool dtape_thread_wait_while_user_suspended_exit(dtape_thread_t* thread) {
+	bool parked = false;
+	if (&thread->xnu_thread != current_thread()) {
+		panic("Cannot wait with non-current thread");
+	}
+	for (;;) {
+		bool use_lock = dtape_suspend_lock_enabled();
+		if (use_lock) {
+			libsimple_lock_lock(&dtape_suspend_lock);
+		}
+		if (thread->xnu_thread.suspend_count <= 0) {
+			thread->suspend_signal_inflight = false;
+			if (use_lock) {
+				libsimple_lock_unlock(&dtape_suspend_lock);
+			}
+			break;
+		}
+		parked = true;
+		dtape_mutex_lock(&thread->suspension_mutex);
+		thread->waiting_suspended = true;
+		dtape_mutex_unlock(&thread->suspension_mutex);
+		dtape_condvar_signal(&thread->suspension_condvar, SIZE_MAX);
+		thread->xnu_thread.wait_result = THREAD_WAITING;
+		dtape_hooks->thread_suspend(thread->context, NULL, NULL, use_lock ? &dtape_suspend_lock : NULL);
+		dtape_mutex_lock(&thread->suspension_mutex);
+		thread->waiting_suspended = false;
+		dtape_mutex_unlock(&thread->suspension_mutex);
+		dtape_condvar_signal(&thread->suspension_condvar, SIZE_MAX);
+		if (thread->xnu_thread.wait_result == THREAD_INTERRUPTED) {
+			if (use_lock) {
+				libsimple_lock_lock(&dtape_suspend_lock);
+			}
+			thread->suspend_signal_inflight = false;
+			if (use_lock) {
+				libsimple_lock_unlock(&dtape_suspend_lock);
+			}
+			break;
+		}
+	}
+	return parked;
+};
